name: Data build

# mods/ -> app/public/game must be up to date, and the Python tests of the
# build and of the content must pass.

on:
  push:
    paths:
      - "mods/**"
      - "tools/**"
      - "tuxemon/**"
      - "nagmon/**"
      - "tests/app/**"
      - "app/public/game/**"
      - "requirements.txt"
      - ".github/workflows/data.yml"
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  data:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
    - uses: actions/checkout@v6
    - uses: actions/setup-python@v6
      with:
        python-version: "3.13"
        cache: pip
    - run: python -m pip install -r requirements.txt pytest pytest-mock pytest-cov numpy scipy
    - name: app/public/game is up to date
      run: python -m tools.app.build_data --check
    - run: python -m pytest tests/app -q
