msgstr "ברגע התפיסה, הטעם הטוב של הנגמון משתנה למשביע."

msgid "tuxeball_peppy"
msgstr "כדור לכידה (תוסס)"

msgid "tuxeball_peppy_description"
msgstr "ברגע התפיסה, הטעם הטוב של הנגמון משתנה לתוסס."

msgid "tuxeball_refined"
msgstr "כדור לכידה (מעודן)"

msgid "tuxeball_refined_description"
msgstr "ברגע התפיסה, הטעם הטוב של הנגמון משתנה למעודן."

msgid "tuxeball_salty"
msgstr "כדור לכידה (מלוח)"

msgid "tuxeball_salty_description"
msgstr "ברגע התפיסה, הטעם הטוב של הנגמון משתנה למלוח."

msgid "tuxeball_zesty"
msgstr "כדור לכידה (חמצמץ)"

msgid "tuxeball_zesty_description"
msgstr "ברגע התפיסה, הטעם הטוב של הנגמון משתנה לחמצמץ."

msgid "tuxeball_grand"
msgstr "כדור לכידה מפואר"

msgid "tuxeball_grand_description"
msgstr "הסיכוי שלו לתפוס גבוה אפילו יותר משל כדור הלכידה היוקרתי."

msgid "tuxeball_majestic"
msgstr "כדור לכידה מלכותי"

msgid "tuxeball_majestic_description"
msgstr "הבחירה הכי טובה כדי לתפוס גם את הנגמונים הכי חמקמקים."

msgid "tuxeball_noble"
msgstr "כדור לכידה אצילי"

msgid "tuxeball_noble_description"
msgstr "שדרוג קטן לכדור הלכידה הרגיל."

msgid "tuxeball_diurnal"
msgstr "כדור לכידה (יום)"

msgid "tuxeball_diurnal_description"
msgstr "תופס בקלות רבה יותר ביום, אבל בלילה הוא עובד הרבה פחות טוב."

msgid "tuxeball_nocturnal"
msgstr "כדור לכידה (לילה)"

msgid "tuxeball_nocturnal_description"
msgstr "תופס בקלות רבה יותר בלילה, אבל ביום הוא עובד הרבה פחות טוב."

msgid "tuxeball_gambler"
msgstr "כדור לכידה (הפתעה)"

msgid "tuxeball_gambler_description"
msgstr ""
"הכדור הזה מלא הפתעות. הסיכוי שלו לתפוס משתנה כל הזמן: לפעמים הוא נמוך מאוד, "
"ולפעמים גבוה מאוד."

msgid "boost_armour"
msgstr "חיזוק שריון"

msgid "boost_armour_description"
msgstr "עד סוף הדו-קרב, השריון עולה ב-2 דרגות."

msgid "boost_dodge"
msgstr "חיזוק התחמקות"

msgid "boost_dodge_description"
msgstr "עד סוף הדו-קרב, ההתחמקות עולה ב-2 דרגות."

msgid "boost_melee"
msgstr "חיזוק קרב מגע"

msgid "boost_melee_description"
msgstr "עד סוף הדו-קרב, קרב המגע עולה ב-2 דרגות."

msgid "boost_ranged"
msgstr "חיזוק מרחוק"

msgid "boost_ranged_description"
msgstr "עד סוף הדו-קרב, המתקפות מרחוק עולות ב-2 דרגות."

msgid "boost_speed"
msgstr "חיזוק מהירות"

msgid "boost_speed_description"
msgstr "עד סוף הדו-קרב, המהירות עולה ב-2 דרגות."

msgid "raise_armour"
msgstr "הגדלת שריון"

msgid "raise_armour_description"
msgstr "ללמוד מהקשיות של היהלום. אימון שריון."

msgid "raise_dodge"
msgstr "הגדלת התחמקות"

msgid "raise_dodge_description"
msgstr "ללמוד מהנצנוץ של האופל. אימון התחמקות."

msgid "raise_hp"
msgstr "הגדלת חיים"

msgid "raise_hp_description"
msgstr "ללמוד מהגודל והשפע של הקוורץ. אימון חיים."

msgid "raise_melee"
msgstr "הגדלת קרב מגע"

msgid "raise_melee_description"
msgstr "ללמוד מהעוצמה של האודם. אימון קרב מגע."

msgid "raise_ranged"
msgstr "הגדלת מרחוק"

msgid "raise_ranged_description"
msgstr "ללמוד מהדיוק של הברקת. אימון מרחוק."

msgid "raise_speed"
msgstr "הגדלת מהירות"

msgid "raise_speed_description"
msgstr "ללמוד מהזריזות של הספינל. אימון מהירות."

msgid "alpha_seep"
msgstr "תמצית אלפא"

msgid "alpha_seep_description"
msgstr ""
"נוזל סמיך עם ריח חזק, שנאסף מהטורפים הכי חזקים בזמן שהם שומרים על השטח שלהם."

msgid "repellent"
msgstr "תרסיס מרחיק"

msgid "repellent_description"
msgstr "תרסיס מסריח שמרחיק נגמונים פראיים."

msgid "fishing_rod"
msgstr "חכה"

msgid "fishing_rod_description"
msgstr "לדוג דגים."

msgid "poseidon"
msgstr "פוסידון"

msgid "poseidon_description"
msgstr "חכה מקצועית."

msgid "neptune"
msgstr "נפטון"

msgid "neptune_description"
msgstr "חכה מתקדמת."

msgid "hatchet"
msgstr "גרזן קטן"

msgid "hatchet_description"
msgstr "לחתוך בולי עץ שחוסמים את הדרך."

msgid "surfboard"
msgstr "גלשן"

msgid "surfboard_description"
msgstr "מתנה מאמא. אפשר לנסוע איתו מהר יותר."

msgid "gold_pass"
msgstr "כרטיס זהב"

msgid "gold_pass_description"
msgstr "ליהנות מהשירותים המפוארים של היכל."

msgid "dojo_pass"
msgstr "כרטיס דוג'ו"

msgid "dojo_pass_description"
msgstr "כניסה לאדם אחד לדוג'ו היסודות."

msgid "book_wishes"
msgstr "ספר המשאלות"

msgid "book_wishes_description"
msgstr "רשימת ההישגים של חובב ההישגים - אתגרים בשבילך."

msgid "earthmover_key"
msgstr "מפתח הדחפור"

msgid "earthmover_key_description"
msgstr "יכול לעזור אם דחפור ענק חוסם את הדרך."

msgid "sledgehammer"
msgstr "פטיש גדול"

msgid "sledgehammer_description"
msgstr "לשבור סלעים אפורים."

msgid "shammer_fossil"
msgstr "מאובן Shammer"

msgid "shammer_fossil_description"
msgstr "נראה כמו ראש של כלב עתיק, אבל הוא קשה כמו אבן."

msgid "rhincus_fossil"
msgstr "מאובן Rhincus"

msgid "rhincus_fossil_description"
msgstr "נראה כמו ראש של ציפור עם שיניים, אבל הוא קשה כמו אבן."

msgid "nu_phone"
msgstr "נו-פון"

msgid "nu_phone_description"
msgstr "אפשר לעשות איתו המון דברים, למשל להתקשר הביתה."

msgid "bivouac"
msgstr "אוהל"

msgid "bivouac_description"
msgstr "לנוח כמו במרפאה אמיתית. נגמר אחרי שימוש אחד."

msgid "drone"
msgstr "רחפן"

msgid "drone_description"
msgstr "להחליף נגמון אחד מהקבוצה בנגמון מהמחסה."

msgid "spyder_pass"
msgstr "כרטיס ספיידר"

msgid "spyder_pass_description"
msgstr ""
"הכרטיס הזה אמור להכניס אותך למקומות שרק הקושרים של ספיידר נכנסים אליהם."

msgid "app_radio"
msgstr "אפליקציית רדיו"

msgid "app_radio_description"
msgstr "שידורים מקומיים, עדכוני הרפתקאות ופטפוטים מכל האזור."

msgid "app_banking"
msgstr "אפליקציית בנק"

msgid "app_banking_description"
msgstr "כאן אפשר להגיע לכסף שלך בכל פעם שנמצאים בעיר."

msgid "app_contacts"
msgstr "אפליקציית אנשי קשר"

msgid "app_contacts_description"
msgstr "להתקשר לחברים ולערוך דו-קרב עם מי שרוצים."

msgid "app_map"
msgstr "אפליקציית מפה"

msgid "app_map_description"
msgstr "בטלפון אפשר לראות בעזרתה איפה נמצאים."

msgid "app_renaming"
msgstr "אפליקציית שינוי שם"

msgid "app_renaming_description"
msgstr "לתת לנגמון שלך שם חדש - שיהיה באמת שלך!"

msgid "app_tuxepedia"
msgstr "אפליקציית נגמופדיה"

msgid "app_tuxepedia_description"
msgstr "כאן שומרים מידע על נגמונים ומשתפים אותו עם העולם."

msgid "p_trepidation"
msgstr "חשש"

msgid "p_trepidation_description"
msgstr "הציור \"חשש\", צבעי שמן על בד. חתום בידי האמן."

msgid "p_starry_night"
msgstr "ליל כוכבים"

msgid "p_starry_night_description"
msgstr "הציור \"ליל כוכבים, כוכבים, כוכבים\", צבעי שמן על בד. חתום בידי האמן."

msgid "p_monsters_eyes"
msgstr "מבטים נפגשים"

msgid "p_monsters_eyes_description"
msgstr "הציור \"כשהעיניים של המפלצות נפגשות\", צבעי שמן על בד. חתום בידי האמן."

msgid "ancient_egg"
msgstr "ביצה עתיקה"

msgid "ancient_egg_description"
msgstr "ביצה מוזרה. אם שותלים אותה, אולי היא תבקע."

msgid "restoration"
msgstr "שיקום"

msgid "restoration_description"
msgstr "מסיר כל מצב שמשפיע עכשיו על המטרה."

msgid "cureall"
msgstr "מרפא הכול"

msgid "cureall_description"
msgstr "מרפא את הנגמון לגמרי ומסיר ממנו כל מצב."

msgid "escape_key"
msgstr "מפתח בריחה"

msgid "escape_key_description"
msgstr "לחמוק החוצה מהדלת האחורית."

msgid "unknown_object"
msgstr "חפץ לא מוכר"

msgid "unknown_object_description"
msgstr ""
"לא ידוע מאיפה הוא הגיע ומה עושים איתו. צריך לזהות אותו לפני שמשתמשים בו."

msgid "bite_of_despair"
msgstr "ביס של ייאוש"

msgid "bite_of_despair_description"
msgstr "קודם מגיע הריח. ואז הטעם גומר את העבודה בלי רחמים."

msgid "whispersoup"
msgstr "מרק לחישות"

msgid "whispersoup_description"
msgstr "המצקת רועדת בזמן ההגשה. אף אחד לא מדבר על מה שקרה אחר כך."

msgid "inferno_custard"
msgstr "רפרפת לוהטת"

msgid "inferno_custard_description"
msgstr "חמה מדי לאכול. מכושפת מדי להתעלם. הקערה מתפצפצת מרוב חרטה."

msgid "dread_omelette"
msgstr "חביתת אימה"

msgid "dread_omelette_description"
msgstr "היא שוברת את כל חוקי המרקם והטעם. אפילו המזלג והכף מתמרדים."

msgid "meal_dust"
msgstr "אבקת קמח"

msgid "meal_dust_description"
msgstr ""
"תערובת עדינה של דגנים משדות השמיים, שנטחנו באור הירח. קלה וגמישה, וחשובה לכל"
" מה שאופים, מקפלים או מטגנים."

msgid "sweetroot"
msgstr "שורש מתוק"

msgid "sweetroot_description"
msgstr ""
"פקעות זוהרות מהגומות של היער הלוחש. מתוקות ורכות עם נגיעה של הדרים - מושלמות"
" לקינוחים ולתוספות חמצמצות."

msgid "mistflour_eggs"
msgstr "ביצי ערפל"

msgid "mistflour_eggs_description"
msgstr ""
"ביצים מסתוריות של ציפורים שישנות על עננים. הקליפה רכה והן מלאות באוויר קסום,"
" והן מתפיחות ומחברות מנות כמו בחלום."

msgid "suncrust_butter"
msgstr "חמאת שמש"

msgid "suncrust_butter_description"
msgstr ""
"שמנת זהובה ועשירה שנסחטה מפרחי עלי-שמש. חמה, חלקה ועם ריח עדין של עשבי תיבול"
" - מרככת, מבריקה ומעשירה כל מנה."

msgid "crackle_salt"
msgstr "מלח מתפצפץ"

msgid "crackle_salt_description"
msgstr ""
"מינרלים נוצצים שנכרו במערות עם הד. מוסיפים טעם וברק למתכונים מלוחים, ולפעמים"
" מתפוצצים באמצע הביס!"

msgid "starpepper"
msgstr "פלפל כוכבים"

msgid "starpepper_description"
msgstr ""
"גרגרים זוהרים וזעירים שמבשילים רק באור הכוכבים. חריפים אבל מתוקים, והחום "
"שלהם מדגדג ולא שורף."

msgid "sky_feather"
msgstr "נוצת שמיים"

msgid "sky_feather_description"
msgstr ""
"נוצות שנשרו מציפורי הרוח אחרי הנדידה. עדינות, קלות ופריכות - אהובות במנות "
"תוססות."

msgid "stonefruit_bulbs"
msgstr "פקעות פרי אבן"

msgid "stonefruit_bulbs_description"
msgstr ""
"צמחי שורש משביעים מעמקי הרי הגעש. מוצקים כמו בשר, טעימים כמו פטריות, "
"ומשביעים מאוד."

msgid "field_greens"
msgstr "ירוקי שדה"

msgid "field_greens_description"
msgstr ""
"עלים פראיים שמחליפים צבע ברוח. רעננים ופלפליים, ואוכלים אותם טריים - או "
"מחוממים רק עד שהם מתקפלים."

msgid "beastmoss"
msgstr "טחב חיות"

msgid "beastmoss_description"
msgstr ""
"טחב עבה שנדבק ליצורים עתיקים ולאבנים קדומות. לעיס ואדמתי, ומושלם במאפים "
"פריכים או בפשטידות משביעות."

msgid "glowfat"
msgstr "שמן זוהר"

msgid "glowfat_description"
msgstr "שמן שהופק מגפנים זוהרות. מרקם משיי וריח של חמאה - לבישול או להברקה."

msgid "moo_bloom"
msgstr "פרח מו"

msgid "moo_bloom_description"
msgstr "צוף חלבי מחיות אחו שקטות. חלק ומנחם, עם טעם של עשב דבש וגבעול סוכר."

msgid "zestsap"
msgstr "מיץ זסט"

msgid "zestsap_description"
msgstr ""
"סירופ מחושמל מעצי פרי-עקצוץ. חד, כמו הדרים, וחי מאוד על הלשון - מעיר טעמים "
"ישנוניים."

msgid "zestroot_wraps"
msgstr "עטיפות שורש זסט"

msgid "zestroot_wraps_description"
msgstr ""
"נבטים גמישים שמשמשים כעטיפות אכילות. קפיציים ועם תבלין עדין בפנים - אהובים "
"במנות רכות שמקפלים."

msgid "root_beast_bark"
msgstr "קליפת שורש"

msgid "root_beast_bark_description"
msgstr ""
"רצועות צמח קשות בצורת צלעות. מעושנות וסיביות עם טעם עמוק - מתובלות כמו בשר, "
"אבל עשויות מצמחים."

msgid "flamehorn_shank"
msgstr "פרוסות קרן אש"

msgid "flamehorn_shank_description"
msgstr ""
"פרוסות עבות מצמחי קרן אש ענקיים שמגדלים לצלייה. נועזות, חרוכות ומלאות טעם."

msgid "spice_dust"
msgstr "אבקת תבלינים"

msgid "spice_dust_description"
msgstr ""
"גבישים כתושים עם ניצוץ של אש ותמצית פרי-עקצוץ. מהבהבים על הלשון ומעירים כל "
"מנה."

msgid "rub_pork_chops"
msgstr "צלעות צמחיות מתובלות"

msgid "rub_pork_chops_description"
msgstr ""
"פרוסות קליפת שורש מצופות באבקה מתפצפצת. מעושנות, חריפות ונועזות - מתובלות "
"כמו בשר, אבל כולן מצמחים."

msgid "mille_feuille"
msgstr "מילפיי"

msgid "mille_feuille_description"
msgstr "מאפה שכבות מקמח ערפל ושמנת פרח מו. עשיר, עדין ומלא מתיקות."

msgid "cheesecake"
msgstr "עוגת גבינה"

msgid "cheesecake_description"
msgstr "עוגה רכה מפרח מו עם מערבולת של שמן זוהר. קרמית ומפנקת עם נצנוץ עדין."

msgid "cream_puffs"
msgstr "פחזניות"

msgid "cream_puffs_description"
msgstr "פחזניות שורש מתוק במילוי קרם קסום. קלות, אווריריות ומפנקות מאוד."

msgid "crepes"
msgstr "קרפים"

msgid "crepes_description"
msgstr "קרפים דקים מאבקת קמח עם מילוי נוצץ. עדינים, מתוקים וקצת פלפליים."

msgid "rub_steak"
msgstr "סטייק מתובל"

msgid "rub_steak_description"
msgstr "צלי בסגנון קרן אש עם גבישי תבלין. נועז, צרוב וחם."

msgid "meatballs"
msgstr "קציצות"

msgid "meatballs_description"
msgstr "כדורים מפקעות פרי אבן ברוטב מיץ זסט. משביעים, חמצמצים ומספקים בקסם."

msgid "shell_tacos"
msgstr "טאקו"

msgid "shell_tacos_description"
msgstr ""
"טאקו בעטיפת שדה עם מילוי שורש זסט ורוטב פרח מו. רענן, קפיצי ומלא חיים."

msgid "potato_casserole"
msgstr "פשטידת תפוחי אדמה"

msgid "potato_casserole_description"
msgstr "שכבות של שורש מתוק וקמח ערפל, אפויות במיץ זסט. חמה והדרית עם ביס רך."

msgid "phyllo"
msgstr "מאפה פילו"

msgid "phyllo_description"
msgstr "עטיפה פריכה במילוי טחב חיות חמצמץ. שכבות עדינות עם לב אדמתי."

msgid "croissants"
msgstr "קרואסונים"

msgid "croissants_description"
msgstr "קרואסוני חמאת שמש עם אבקה חמצמצה. פריכים, זהובים וקצת מחושמלים."

msgid "rub_chicken"
msgstr "שניצל מתובל"

msgid "rub_chicken_description"
msgstr "שניצלים מנוצות שמיים בתערובת פלפל כוכבים. קלים, פריכים ומתובלים היטב."

msgid "heart_biscuit"
msgstr "עוגיית לב"

msgid "heart_biscuit_description"
msgstr "עוגייה שמתחלקת לשני חצאים שווים. היא מחממת את הלב של מי שמתחלקים בה."

msgid "potato_fries"
msgstr "צ'יפס"

msgid "potato_fries_description"
msgstr "צ'יפס משורש מתוק עם תערובת מלח קסום. קריספי, זוהר ומפתיע."

msgid "pretzels"
msgstr "בייגלה"

msgid "pretzels_description"
msgstr ""
