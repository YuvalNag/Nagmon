msgid "spyder_hospital_passcode_color"
msgstr ""
"הכניסה לקומה 2 מוגבלת. נא להקיש קוד. \n"
" צבע?"

msgid "spyder_hospital_passcode_number"
msgstr "ומספר?"

msgid "spyder_hospital_passcode_rejected"
msgstr "הקוד לא נכון."

msgid "spyder_hospital_pc_message1"
msgstr ""
"מייל מחוקר 1\n"
" 'דוקטור לי, ניתחתי את דגימות הנגיף, ואני חושב שכדאי לנסות זן אחר.\n"
" אולי הוא יעורר תגובה חדשה בנוגדנים.'"

msgid "spyder_hospital_pc_message2"
msgstr ""
"פתק מחוקר 2\n"
" 'דוקטור לי, מצאתי שילוב של אנזימים ונוגדנים שאולי יאט את קצב השינוי של הנגיף.\n"
" אני מריץ עכשיו הדמיות במחשב.'"

msgid "spyder_hospital_pc_message3"
msgstr ""
"תוצאות הדמיה מחוקר 2\n"
" 'השילוב של אנזימים ונוגדנים מראה תוצאות מבטיחות. אולי יש לנו תרופה ביד.'"

msgid "spyder_hospital_pc_message_rivalry1"
msgstr ""
"מייל מחוקר 1\n"
" 'חוקר 2, אני לא בטוח שאני מסכים עם הדרך שלך. צריך להיות זהירים ומסודרים יותר במחקר.\n"
" ההדמיות שלך מבטיחות, אבל אסור למהר להסיק מסקנות.'"

msgid "spyder_hospital_pc_message_rivalry1b"
msgstr "ועל המסך, פתק דביק: 'לזכור: כחול.'"

msgid "spyder_hospital_pc_message_rivalry2"
msgstr ""
"מייל מחוקר 2\n"
" 'חוקר 1, אתה תמיד כל כך זהיר ואיטי. צריך לקחת סיכונים ולנסות דברים חדשים.\n"
" המחקר שלנו חשוב מדי, אסור שהפחד שלך מכישלון יעצור אותו.'"

msgid "spyder_hospital_pc_message_rivalry2b"
msgstr "ועל פיסת נייר קרועה: 'חשיבה בינארית: 10 זה שתיים.'"

msgid "spyder_hospital_pc_message4"
msgstr ""
"מייל ממשגיח\n"
" 'דוקטור לי, יש לנו סיבה לחשוב שערכת מחקר בלי אישור. אנחנו נמצאים במקום שלך ומבקשים שתבוא איתנו.'"

msgid "spyder_hospital_pc_message5"
msgstr ""
"מייל מדוקטור לי לדוקטור צ'ן, המורה שלו\n"
" 'הם דופקים על הדלת שלי ורוצים לקחת אותי בגלל מחקר בלי אישור. אני לא יכול לתת להם לקחת לי את זה.\n"
" זו פריצת דרך, תרופה אמיתית. אני חייב לשתף אותה עם העולם.'"

msgid "spyder_hospital_pc_message6"
msgstr ""
"מייל מחוקר 1\n"
" 'דוקטור לי, הצלחתי לבודד זן חדש של הנגיף שנראה שהטיפולים שלנו עובדים עליו.\n"
" אבל אני מודאג מבחינת אבטחה. צריך להיזהר מאוד מי יודע על התגלית הזאת.'"

msgid "spyder_hospital_pc_message7"
msgstr ""
"מייל ממשגיח: 'דוקטור לי\n"
" קיבלנו מידע שאתה עורך מחקר בלי אישור בתוך החברה.\n"
" יש לנו סיבה לחשוב שהעבודה שלך מסכנת מאוד את הארגון שלנו.\n"
" עליך להפסיק מיד את כל המחקר ולהתייצב במשרד האבטחה.'"

msgid "spyder_hospital_pc_message8"
msgstr ""
"מייל ממודיע מסתורי\n"
" 'יש אנשים שרוצים שתיכשל. הם יעשו הכול כדי להרוס את העבודה שלך. תיזהר.'"

msgid "spyder_hospital_pc_message9"
msgstr ""
"מייל מעוזר רובוטי\n"
" 'זיהיתי כניסה לא מורשית לקבצי המחקר שלך. נא לבדוק מיד.'"

msgid "spyder_hospital1_aurora1"
msgstr ""
"מהר מאוד יתברר לך שבחרת לעצמך לשותפת אימון\n"
" את המאמנת הכי מוכשרת בבניין."

msgid "spyder_hospital1_aurora2"
msgstr "לא רע בכלל. אולי אפשר לגייס אותך לספיידר?"

msgid "spyder_hospital1_eleni1"
msgstr "ברכותיי. הבה נבחן את עוצמתך מול האוסף המופלא שלי."

msgid "spyder_hospital1_eleni2"
msgstr "אוף, שטויות!"

msgid "spyder_hospital1_felu1"
msgstr "נראה שאתגר יעשה לך טוב."

msgid "spyder_hospital1_felu2"
msgstr "נו, לא אמרתי שהאתגר יהיה אני."

msgid "spyder_hospital1_fring1"
msgstr "הבוס אומר שאסור לנו לקחת לעצמנו את הנגמונים המוחבאים... בינתיים."

msgid "spyder_hospital1_fring2"
msgstr "זה היה הרבה יותר קל עם Moloch או שניים!"

msgid "spyder_hospital1_liane1"
msgstr "קשה להאמין איזה נגמונים חזקים התמימים האלה מסרו לנו."

msgid "spyder_hospital1_liane2"
msgstr "אולי ניצחת אותי, אבל את ספיידר אי אפשר לעצור."

msgid "spyder_hospital1_luzia1"
msgstr "קל כמו לקחת סוכרייה מתינוק."

msgid "spyder_hospital1_luzia2"
msgstr ""
"וואה!\n"
" מה הטעם להציב פה כל כך הרבה מאיתנו?\n"
" אף אחד לא יעבור את חוסם ה-DNA בכל מקרה."

msgid "spyder_hospital1_pem1"
msgstr "אני לא זוכר אותך מיום הקליטה."

msgid "spyder_hospital1_rea1"
msgstr ""
"להחרים את כל הנגמונים היה בזבוז זמן.\n"
" אף מאמן לא יכול לעצור את מפלצות-העל שספיידר מגדלים. "

msgid "spyder_hospital1_walt1"
msgstr "מה קרה למדים שלך? רגע, מתחזה! לא לזוז!"

msgid "spyder_hospital1_walt2"
msgstr ""
"אני אצטרך לדווח על זה למשרד הראשי.\n"
" תודה על כלום."

msgid "spyder_hospital1_zekar1"
msgstr "היי! לא לזוז!"

msgid "spyder_hospital1_zekar2"
msgstr "אולי ניצחת אותי, אבל אין סיכוי לנצח את מה שמכינים במטה."

msgid "spyder_hospital1_rakez1"
msgstr ""
"הצטרפתי רק בשביל המשכורת.\n"
" מה רע בזה?"

msgid "spyder_hospital1_rakez2"
msgstr "טוב, טוב, הבנתי את הנקודה."

msgid "spyder_hospital1_rhizome1"
msgstr ""
"לא לזוז!\n"
" מה שמולך הוא קניין רוחני של אומניצ'אנל!"

msgid "spyder_hospital1_rhizome2"
msgstr ""
"אולי יש לך סיכוי לנצח אותי, אבל את עורכי הדין של הפטנטים אף אחד לא מנצח."

msgid "spyder_hospital1_nurse1"
msgstr ""
"חייבים לעצור אותם!\n"
" הנבלים האלה השתלטו על בית החולים,\n"
" והם לא נותנים לנו לשחרר את התרופה."

msgid "spyder_hospital2_nurse1"
msgstr ""
"בידוד יכול לעזור, במיוחד לאנשים שאין להם נגמונים שירפאו אותם,\n"
" אבל ספיידר ניצלו את הבידוד הזה בצורה לא הוגנת בכלל.\n"
" אז לא אכפת לי להחזיר לך בשקט אחת מהמפלצות שלך."

msgid "spyder_hospital1_scientist1"
msgstr ""
"לא רצינו שייקחו את הנגמונים האלה, אבל כל עוד הם פה, אנחנו נשמור עליהם.\n"
" הנה, הברחתי החוצה אחת מהמפלצות שלך. היא אמורה להיות בריאה מהמחלה."

msgid "spyder_hospital1_scientist2"
msgstr ""
"בואו ננצל את המצב.\n"
" הנה מפלצת שלך, מחוץ לבידוד.\n"
" אל תספרו לאף אחד שהבאתי לך אותה."

msgid "spyder_hospital2_scientist2"
msgstr "פססט! מוכר לך?"

msgid "spyder_hospital2_scientist1"
msgstr ""
"יש לנו תרופה, אבל אנחנו כל הזמן נתקעים במערכת הנעילה הדיגיטלית של ההיכל."

msgid "spyder_hospital_good_luck"
msgstr "בהצלחה!"

msgid "spyder_omnichannel_zoolander1"
msgstr "יש בך משהו של יהלום שעוד לא לוטש, נכון?"

msgid "spyder_omnichannel_donald1"
msgstr "שוב פה? הייתי צריך לטפל בך כבר במטה של סקופ."

msgid "spyder_hospital_warning1"
msgstr ""
"בזזזז. זוהה יצור חי. \n"
" הדלתות נשארות סגורות."

msgid "spyder_hospital_nurse1"
msgstr ""
"המחסום בנוי לזהות ולעצור בני אדם ונגמונים. \n"
" מקודד בו ה-DNA של כל הנגמונים הידועים! "

msgid "spyder_hospital_warning2"
msgstr ""
"\"Aardant\" הוא לא יצור חי מוכר. \n"
" המערכת נכבית."

msgid "spyder_hospital_cure1"
msgstr ""
"זו התרופה לעקיצת עכביש! \n"
" איתה אפשר לרפא את הנגמונים שלך וגם של אחרים."

msgid "spyder_hospital_cure2"
msgstr "המפלצות שלך חוזרות אליך."

msgid "spyder_searoutec_nigel3"
msgstr ""
"סליחה, אני לא יכול להרשות כניסה למערה הקדושה כל עוד המחלה של עקיצת עכביש "
"מתפשטת."

msgid "spyder_hospital_billie1"
msgstr "${{name}}, ההתערבות שלך כבר מוגזמת! תנו לרשויות לעשות את העבודה שלהן!"

msgid "spyder_hospital_billie2"
msgstr ""
"רגע... הנגמונים שלך לא חולים! \n"
" ... \n"
" זה היה כזה פשוט? \n"
" אז למה המשגיחים לקחו את הנגמונים שלנו במקום פשוט לרפא אותם? ..."

msgid "spyder_mansion_drinkingbuddya1"
msgstr "מעניין לאן נעלם החבר שלנו מבית הקפה?"

msgid "spyder_mansion_drinkingbuddyb1"
msgstr "התחלנו לשיר שיר מלחים ישן, ועד שסיימנו, הקפטן נעלם!"

msgid "spyder_mansion_drinkingbuddya2"
msgstr "הנה אתה, חבר ותיק! בוא נחזיר אותך לנהר."

msgid "spyder_mansion_captain1"
msgstr ""
"אהוי! תודה שמצאת אותי! \n"
" הסתובבתי לבד אחרי מסיבת המיץ של אתמול בלילה, ונפלתי לכאן. \n"
" היי, אולי תעזרו לי למצוא את היציאה? רק תצעקו כשתמצאו אותה."

msgid "spyder_river_captain2"
msgstr "אהוי! לאן מפליגים?"

msgid "spyder_river_captain_nomonsters"
msgstr "סליחה, אני לא יכול לקחת אותך אם אין לך מפלצות שישמרו עליך."

msgid "spyder_mansion_magician1"
msgstr ""
"ברוכים הבאים לאחוזת הבזאר.\n"
" אל תשימו לב לעובש ולמדרגות החורקות, רק עכשיו עברנו לפה."

msgid "spyder_mansion_painting"
msgstr "נראה שהעיניים בציור עוקבות אחריך בכל החדר."

msgid "spyder_mansion_picnicker"
msgstr ""
"בצוות בזאר אנחנו אוהבים לבלות במקומות נידחים, כדי שאומניצ'אנל לא יוכלו לרגל "
"אחרינו."

msgid "spyder_mansion_gillette1"
msgstr "אה-הא, סוף סוף - יריב ראוי."

msgid "spyder_mansion_gillette2"
msgstr "נראה שהחלדתי קצת."

msgid "spyder_mansion_lucy1"
msgstr "ניסיתם פעם לשתות תה מלכותי? אני ניסיתי - ולמדתי כל כך הרבה!"

msgid "spyder_mansion_lucy2"
msgstr "אולי הייתי צריכה לחלוק את התה עם הנגמונים שלי."

msgid "spyder_mansion_lucy3"
msgstr "היי, כדאי לנסות את זה!"

msgid "spyder_mansion_barmaid"
msgstr ""
"אנחנו מתכוונים לתבוע זכויות דיירים על האחוזה הזאת.\n"
" נשארו רק עוד 13 וחצי שנים!"

msgid "spyder_mansion_magician2"
msgstr ""
"נראה שמי שהאחוזה הזאת שייכת לו שכח ממנה.\n"
" תארו לעצמכם שיש לכם כל כך הרבה בתים, שאחד מהם פשוט נשכח!"

msgid "spyder_mansion_pirate1"
msgstr "ארררר, תנו לי את הכסף ואת כדורי הלכידה שלכם."

msgid "spyder_mansion_pirate2"
msgstr "אל תיבהלו! אני לא פיראט אמיתי, רק מעריץ גדול של פיראטים."

msgid "spyder_basement_baller"
msgstr "ברררר, קר פה למטה."

msgid "spyder_basement_rogue"
msgstr "באמת כדאי שיתקנו את החור הזה ברצפה."

msgid "spyder_basement_coralli1"
msgstr "תמיד אהבתי את ההתרגשות של דו-קרב נגמונים."

msgid "spyder_basement_coralli2"
msgstr "קשה לחזור לשגרה אחרי דו-קרב סוער."

msgid "spyder_basement_roger1"
msgstr "שלום. אני ילד אנושי."

msgid "spyder_basement_roger2"
msgstr "אוף, יש לי עוד הרבה מה ללמוד!"

msgid "spyder_basement_catholi1"
msgstr "כלי של רופא יכול לעזור, ויכול גם להפחיד."

msgid "spyder_basement_catholi2"
msgstr "הנה, אין סיבה לפחד."

msgid "spyder_basement_bobby1"
msgstr ""
"גם לך יש שיגעון לנגמונים?\n"
"  אני משוגע עליהם מאז שהייתי בן 8."

msgid "spyder_basement_bobby2"
msgstr "כן, אני משוגע על נגמונים כבר שנה שלמה."

msgid "spyder_basement_josephine1"
msgstr ""
"אל תשימו לב לחבר שלי שאוהב ריבים.\n"
" לרפא את הנגמונים שלך?"

msgid "spyder_basement_josephine2"
msgstr "מקווה שהריפוי עזר."

msgid "spyder_top_russell1"
msgstr "שמעת על Botbot? זה הנגמון הכי גמיש שיש, הוא מתאים להכול."

msgid "spyder_top_russell2"
msgstr "זה שהוא מתאים להכול, לא אומר שהוא חזק."

msgid "spyder_top_jackson1"
msgstr "נגמונים הם מה שעושים מהם. מאמנים חלשים מגדלים נגמונים חלשים."

msgid "spyder_top_jackson2"
msgstr "לא היה לי מזל הפעם."

msgid "spyder_top_mickey1"
msgstr ""
"תהית פעם אם החיים הם אשליה אחת גדולה, \n"
"שמוקרנת על מסך בשביל מישהו ביקום אחר?"

msgid "spyder_top_mickey2"
msgstr "טוב, אני טוען מחדש."

msgid "spyder_top_ricardo1"
msgstr "פעם הייתי בדיוק כמוך, מלא התלהבות אבל בלי הרבה כישרון."

msgid "spyder_top_ricardo2"
msgstr "אני רואה את עצמי בך."

msgid "spyder_top_dancer"
msgstr ""
"ההורים שלי חושבים שאני חשדנית מדי, אבל אני פשוט לא סומכת על אומניצ'אנל.\n"
" או על סקופ. או על שאפט. או על גרינוואש. ואם כבר, גם לא על נמרוד."

msgid "spyder_top_barmaid"
msgstr ""
"התאגידים הגדולים מוכרים מפלצות שיכולות להשתנות רק בעזרת הטכנולוגיה הפרטית "
"שלהם!"

msgid "spyder_top_magician1"
msgstr ""
"ביקרת פעם בדוג'ו בעיר הפרחים?\n"
" לא? מישהו שאוהב דו-קרבות כמוך?"

msgid "spyder_top_magician2"
msgstr "טוב, זה אמור לעזור."

msgid "spyder_top_magician3"
msgstr "כדאי ללכת לדוג'ו בעיר הפרחים ולבדוק כמה טובים כישורי הדו-קרב שלך."

msgid "spyder_mansion_gillette"
msgstr "ג'ילט"

msgid "spyder_mansion_lucy"
msgstr "לוסי"

msgid "spyder_mansion_lyle"
msgstr "לייל"

msgid "spyder_basement_coralli"
msgstr "קוראלי"

msgid "spyder_basement_roger"
msgstr "רוג'ר"

msgid "spyder_basement_catholi"
msgstr "קתולי"

msgid "spyder_basement_bobby"
msgstr "בובי"

msgid "spyder_basement_josh"
msgstr "ג'וש"

msgid "spyder_top_russell"
msgstr "ראסל"

msgid "spyder_top_jackson"
msgstr "ג'קסון"

msgid "spyder_top_mickey"
msgstr "מיקי"

msgid "spyder_top_ricardo"
msgstr "ריקרדו"

msgid "spyder_wayfarerinn_tv1"
msgstr ""
"החדשות משודרות. \n"
" המגישים אומרים שיש שמועות לא מבוססות על מחלה."

msgid "spyder_dryadsgrove_volcoli1"
msgstr "ברי! ברי!"

msgid "spyder_dryadsgrove_aquemini1"
msgstr "ברוכים הבאים לחורשה שלנו, בני אנוש."

msgid "spyder_dryadsgrove_aquemini2"
msgstr "נקווה שהביקור יעבור עליך בשלום."

msgid "spyder_dryadsgrove_ignatia1"
msgstr "אנחנו יותר ממה שנראה."

msgid "spyder_dryadsgrove_ignatia2"
msgstr "וגם בך יש יותר ממה שנראה."

msgid "spyder_dryadsgrove_petra1"
msgstr "לשבור את התבניות של הטבע!"

msgid "spyder_dryadsgrove_petra2"
msgstr "איזו כפיות טובה."

msgid "spyder_dryadsgrove_ferris1"
msgstr "ידוע לך שהערת אותנו משינה של מאות שנים?"

msgid "spyder_dryadsgrove_ferris2"
msgstr "אולי הגיע הזמן שנצא אל העולם."

msgid "spyder_dryadsgrove_sylvia1"
msgstr "העונות מתחלפות עם הריקוד של Volcoli."

msgid "spyder_dryadsgrove_sylvia2"
msgstr "אנחנו, פיות העצים, מתחזקות ונחלשות עם חילופי העונות."

msgid "spyder_dryadsgrove_boy_healthy"
msgstr ""
"וואו, המפלצות שלך נראות ממש בריאות! זה כל כך טוב.\n"
" בטח יש לך הרבה כסף, אם אפשר לטפל בהן ככה.\n"
" היי -- אם אתן לך את החברה שלי RUFF, היא תהיה בידיים טובות, נכון?"

msgid "spyder_dryadsgrove_boy_yes"
msgstr "*מסניף* אני אתגעגע אלייך, חברה שלי. אבל זה לטובה."

msgid "spyder_dryadsgrove_boy_no"
msgstr "אה. כן. מובן. זה ממש יקר, אני יודע."

msgid "spyder_dryadsgrove_boy_not_healthy"
msgstr ""
"היי, המפלצות שלך במצב לא משהו. אני מבין מה עובר עליך.\n"
" ה-WOLFFSKY שלי נפצעה, ועכשיו אין לנו כסף לשלם לרופא שיטפל בה. זה קשה."

msgid "spyder_dryadsgrove_dad1"
msgstr ""
"אני מרגיש רע. כשקנינו לו את ה-WOLFFSKY ליום ההולדת, לא הבנו כמה יעלה הווטרינר.\n"
