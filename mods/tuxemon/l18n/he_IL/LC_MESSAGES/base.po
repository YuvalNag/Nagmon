msgstr "פיה"

msgid "eclipse_route7_penitent"
msgstr "המתחרט"

msgid "eclipse_route7_nino"
msgstr "נינו"

msgid "eclipse_route7_hugh"
msgstr "יו"

msgid "eclipse_route7_arnaut"
msgstr "ארנו"

msgid "eclipse_route7_conrad"
msgstr "קונרד"

msgid "eclipse_route7_manfred"
msgstr "מנפרד"

msgid "eclipse_route7_sordello"
msgstr "סורדלו"

msgid "eclipse_route7_arnold1"
msgstr "שמעת על הנגמון החדש שגילו בארכיפלג?"

msgid "eclipse_route7_sylvester1"
msgstr "הים רחוק מאוד מכאן."

msgid "eclipse_route7_fritz1"
msgstr "ארוחת בוקר רגילה בקריסטל: נקניקיות לבנות, מיץ תפוחים ובייגלה."

msgid "eclipse_route7_statius1"
msgstr "אם אפשר היה לשנות דבר אחד בעצמך, מה היית משנה?"

msgid "eclipse_route7_statius2"
msgstr "כנראה את הקבוצה שלי, קבוצת הנגמונים."

msgid "eclipse_route7_jacopo1"
msgstr "רוצים להוריד אפליקציה?"

msgid "eclipse_route7_jacopo2"
msgstr "האפליקציה מוצאת לזומבים חברים חדשים."

msgid "eclipse_route7_pia1"
msgstr "באמת מתכננים להתעלם ממני?"

msgid "eclipse_route7_pia2"
msgstr "אחרי כל מה שקרה בדו-קרב הזה?"

msgid "eclipse_route7_penitent1"
msgstr "העוגיות עם שוקולד צ'יפס הריחו כל כך טוב, שאכלתי אחת בלי לבקש."

msgid "eclipse_route7_penitent2"
msgstr "בבקשה, אל תספרו לאף אחד!"

msgid "eclipse_route7_nino1"
msgstr "נהניתי מהשקט של הטבע בטיול בהר."

msgid "eclipse_route7_nino2"
msgstr "לא כל כך שקט!"

msgid "eclipse_route7_hugh1"
msgstr "אכפת לך שאני אוכל עוד סוכריה?"

msgid "eclipse_route7_hugh2"
msgstr "איך מפסיקים?"

msgid "eclipse_route7_arnaut1"
msgstr "הבעיה עם רגשי נחיתות היא שהם תמיד אצל האנשים הלא נכונים."

msgid "eclipse_route7_arnaut2"
msgstr "אופס!"

msgid "eclipse_route7_conrad1"
msgstr "על הר האריה ירד שלג, וכל התיירים מתרגשים מאוד."

msgid "eclipse_route7_conrad2"
msgstr "יותר מדי תיירים."

msgid "eclipse_route7_manfred1"
msgstr "נראה לך שהחיים שלנו יחזרו פעם להיות רגילים?"

msgid "eclipse_route7_manfred2"
msgstr "כלומר... אחרי מה שקרה בעיר הכותנה."

msgid "eclipse_route7_sordello1"
msgstr "אם אפשר היה לקנות כל מה שרוצים, מה היית קונה?"

msgid "eclipse_route7_sordello2"
msgstr "כנראה כמה שיקויי התעוררות וכמה שיקויים."

msgid "eclipse_crystal_alert_skating"
msgstr "תמיד להיזהר! תמיד להביא ציוד מגן!"

msgid "eclipse_crystal_hackerchat"
msgstr "לפני שבועיים סופת שלג ענקית פגעה ב-${{map_name}}."

msgid "eclipse_crystal_barmaid"
msgstr "אני לא מחליקה כל כך טוב."

msgid "eclipse_crystal_grannypiper"
msgstr ""
"סופת השלג הגדולה הייתה כל כך חזקה, שעד היום מי ששרד אותה נפגש כדי לזכור."

msgid "eclipse_crystal_monk"
msgstr "זה מזכיר לי את סופת השלג שבה איבדתי חבר טוב."

msgid "eclipse_crystal_granny"
msgstr "אוי... זה עצוב. אני מצטערת לשמוע."

msgid "eclipse_crystal_shopkeeper"
msgstr "אנחנו מכבדים מאוד את ההר, וסומכים עליו שישמור עלינו מכל מה שיבוא."

msgid "eclipse_crystal_maniac"
msgstr ""
"המטפסים צריכים להתעורר ולהבין שטיפוס על הר האריה מסוכן מאוד.\n"
"לא מספיק שיש להם נגמונים חזקים כדי להצליח לטפס."

msgid "eclipse_crystal_beck"
msgstr "זה ממש לא מצחיק, חבר."

msgid "eclipse_crystal_tvwatch"
msgstr "עיתונאית מטיילת בעולם ומחפשת תרבויות אבודות."

msgid "eclipse_lionmountain_jacques"
msgstr "ז'אק"

msgid "eclipse_lionmountain_adam"
msgstr "אדם"

msgid "eclipse_lionmountain_arlene"
msgstr "ארלין"

msgid "eclipse_lionmountain_david"
msgstr "דוד"

msgid "eclipse_lionmountain_alexander"
msgstr "אלכסנדר"

msgid "eclipse_lionmountain_emilio"
msgstr "אמיליו"

msgid "eclipse_lionmountain_chhurim"
msgstr "צ'הורים"

msgid "eclipse_lionmountain_tom"
msgstr "טום"

msgid "eclipse_lionmountain_conrad"
msgstr "קונרד"

msgid "eclipse_lionmountain_kurt"
msgstr "קורט"

msgid "eclipse_lionmountain_snarlon"
msgstr "סנרלון"

msgid "eclipse_lionmountain_jacques1"
msgstr ""
"אף פעם לא הייתי כל כך גבוה \n"
" וזה מאוד מאוד מתיש לטפס על קרח כזה."

msgid "eclipse_lionmountain_jacques2"
msgstr ""
"זה לא רק קשה, לא יציב ומפחיד, \n"
" אלא גם הלב דופק כמו משוגע בגלל הגובה."

msgid "eclipse_lionmountain_adam1"
msgstr "הייתי למעלה, והייתה רוח חזקה."

msgid "eclipse_lionmountain_adam2"
msgstr "ואז התחיל לרדת שלג."

msgid "eclipse_lionmountain_arlene1"
msgstr "לא היו שום נקודות עיגון בדרך."

msgid "eclipse_lionmountain_arlene2"
msgstr "זה היה מאוד מאוד מעייף. טיפוס עם כל הגוף, באמת."

msgid "eclipse_lionmountain_david1"
msgstr "לקח לי בערך חמש או שש שעות לטפס על הקטע האחרון."

msgid "eclipse_lionmountain_david2"
msgstr "המשכתי עוד הרבה אחרי שהחשיך."

msgid "eclipse_lionmountain_alexander1"
msgstr "העננים כבר מגיעים מהמזרח. עננים גדולים."

msgid "eclipse_lionmountain_alexander2"
msgstr "אני מצפה שהרכס הזה יהיה די... להתכונן."

msgid "eclipse_lionmountain_emilio1"
msgstr "חצי שעה עד שעה אחרי שעזבתי את הפסגה, הלכתי לאיבוד."

msgid "eclipse_lionmountain_emilio2"
msgstr "הייתי בשטח פראי, ולא ראיתי כלום."

msgid "eclipse_lionmountain_chhurim1"
msgstr "אני אגיע לפסגה, אני באמת יכולה להגיע לפסגה."

msgid "eclipse_lionmountain_chhurim2"
msgstr "האם יהיה שם מישהו?"

msgid "eclipse_lionmountain_tom1"
msgstr "אני לא יודע בדיוק מה קרה בהמשך הלילה ההוא."

msgid "eclipse_lionmountain_tom2"
msgstr "הפסקתי להסתכל בשעון, והכול התחיל להתבלבל."

msgid "eclipse_lionmountain_conrad1"
msgstr "אני זוכר שהרחתי משהו."

msgid "eclipse_lionmountain_conrad2"
msgstr "זה היה ריח ממש חזק."

msgid "eclipse_lionmountain_kurt1"
msgstr "אני לא מסוגל להמשיך יותר."

msgid "eclipse_lionmountain_kurt2"
msgstr "טעיתי כשנתתי לעצמי קצת תקווה."

msgid "eclipse_lionmountain_snarlon1"
msgstr "גרררר!"

msgid "eclipse_lionmountain_snarlon2"
msgstr "אוףףף."

msgid "eclipse_lionmountain_nurse1"
msgstr "אם להיות כנה איתך, אני מבוגרת יותר ממה שנדמה לך."

msgid "eclipse_lionmountain_scientist1"
msgstr "זה החגב הכי גדול שראיתי בחיים."

msgid "eclipse_lionmountain_enforcer1"
msgstr "אז הבעיה במרכז הנתונים נפתרה?"

msgid "eclipse_lionmountain_enforcer2"
msgstr ""
"זה היה יכול להיות הרבה יותר גרוע.\n"
" אומניצ'אנל פיתחו נגמון שיכול לשלוט ברגשות של אנשים.\n"
" אם קרנל היה משיג את Chromeye, אף אחד לא היה יכול לעצור את זה."

msgid "eclipse_lionmountain_enforcer3"
msgstr "אז כשהכול התקלקל, ברחתי לכאן."

msgid "eclipse_lionmountain_enforcer4"
msgstr "נראה שזה בידיים טובות אצלך. אולי רק לך יש את היכולת."

msgid "eclipse_bank_may"
msgstr "מיי"

msgid "eclipse_bank_brock"
msgstr "ברוק"

msgid "eclipse_bank_daisy"
msgstr "דייזי"

msgid "eclipse_bank_raj"
msgstr "ראג'"

msgid "eclipse_bank_lile"
msgstr "לייל"

msgid "eclipse_bank_kai"
msgstr "קאי"

msgid "eclipse_bank_ethan"
msgstr "איתן"

msgid "eclipse_bank_ava"
msgstr "אווה"

msgid "eclipse_bank_lucas"
msgstr "לוקאס"

msgid "eclipse_bank_bob1"
msgstr "פעם חשבתי שהבנק הזה מייצג משהו - עצמאות, מגדלור מול הצל של ההיכל."

msgid "eclipse_bank_bob2"
msgstr ""
"אבל אז ראיתי סדקים: העברות כסף מוזרות, כסף שנעלם, לחישות על עסקאות עם חברות "
"של ההיכל."

msgid "eclipse_bank_bob3"
msgstr "פיטרו אותי כשהתחלתי לשאול שאלות. משהו פה לא בסדר, ארגון. בכלל לא."

msgid "eclipse_bank_may1"
msgstr "חושבים שאפשר להתמודד עם עולם הכסף הגדול? הוכיחו את זה."

msgid "eclipse_bank_may2"
msgstr "יש לך כישרון. אבל אני לא אשב בשקט אם הכול יתפרק."

msgid "eclipse_bank_brock1"
msgstr "יותר מדי שאלות. בואו נראה אם יש לך גם כוח מאחוריהן."

msgid "eclipse_bank_brock2"
msgstr "יש לך יותר כוח ממה שחשבתי. אבל מעכשיו אני מגביר את האבטחה."

msgid "eclipse_bank_daisy1"
msgstr "עושי צרות לא מחזיקים פה הרבה זמן. בואו נראה מה יש לך."

msgid "eclipse_bank_daisy2"
msgstr ""
"יש לך כוח רב, את זה אני מודה. אבל אמון? אמון מרוויחים לאט, לא בדו-קרב."

msgid "eclipse_bank_jeff1"
msgstr "המקום הזה נראה נקי - אבל ראיתי את הלכלוך שמתחת. מוכנים לחפור?"

msgid "eclipse_bank_bin1"
msgstr ""
"יש כאן קבלה מקומטת: 'משלוחי הארכיפלג - משלוח עצים לאזור פונדנט (סודי).'"

msgid "eclipse_bank_bin2"
msgstr ""
"מתחתיה, מסמך עם חותמת: 'טרהפורם יזמים - בניית מתקן ניסיוני (פרויקט ליקוי).'"

msgid "eclipse_bank_bin3"
msgstr ""
"פתק קרוע, כתוב בחיפזון: 'פגישה עם ג' בתחנת הכוח. לדבר על תפוקת אנרגיה. "
"עיניים בכל מקום. לא להיתפס.'"

msgid "eclipse_bank_raj1"
msgstr "באתי רק להפקיד צ'ק - אבל נראה שהמקום הזה עומד להתפוצץ."

msgid "eclipse_bank_raj2"
msgstr "יש לך יותר אומץ ממה שחשבתי. רק להיזהר - לבנק הזה יש סודות עמוקים."

msgid "eclipse_bank_lile1"
msgstr "מצאתי סימנים שמובילים להיכל. רוצים לעזור לי לבדוק תיאוריה?"

msgid "eclipse_bank_lile2"
msgstr "הוכחת את עצמך. עכשיו בואו נחשוף את החוטים שההיכל מושך מאחורי הקלעים."

msgid "eclipse_bank_kai1"
msgstr ""
"הרשומות לא משקרות - אלא אם מישהו משנה אותן. בואו נראה אם יש לך כוח לשמוע את "
"האמת."

msgid "eclipse_bank_kai2"
msgstr ""
"יש לך אומץ. אני אספר מה מצאתי - אבל צריך להיזהר. ההיכל לא אוהב הדלפות."

msgid "eclipse_bank_ethan1"
msgstr "הספרים של טוקסוולט נקיים - נקיים מדי. בואו נראה אם אפשר לגרד את הברק."

msgid "eclipse_bank_ethan2"
msgstr "יש לך אומץ. אולי דווקא לך יש את הכוח לחשוף את השקרים שמתחת למספרים."

msgid "eclipse_bank_ava1"
msgstr ""
"סימנתי העברות כסף חשודות. אם האמת חשובה לך, הגיע הזמן להוכיח שאין פה סתם עוד"
" כלי במשחק."

msgid "eclipse_bank_ava2"
msgstr "יש בך יותר ממה שנראה. רק לזכור - ההיכל לא משחק הוגן."

msgid "eclipse_bank_lucas1"
msgstr ""
"צריך אומץ כדי לבוא לכאן. אני יכול להביא לך הרבה כסף - אם לא אכפת לך להתלכלך."

msgid "eclipse_bank_lucas2"
msgstr "אז עסקאות לא מעניינות אותך? בסדר. אבל אל תצפו לצאת מזה בלי פגע."

msgid "eclipse_zircon"
msgstr "זירקון"

msgid "eclipse_zircon1"
msgstr ""
"אז סוף סוף הגעת, ארגון. חיכיתי לרגע הזה. עכשיו נראה אם האידיאלים שלך יעמדו "
"מול כוח אמיתי."

msgid "eclipse_zircon2_lose"
msgstr ""
"איזו חולשה, ארגון. זה הכוח שהעקרונות שלך נותנים לך? אין לך כוח להגן על אף אחד - בטח לא על עצמך.\n"
" כדאי לזכור את ההפסד הזה. זה הדבר היחיד שבאמת הרווחת."

msgid "eclipse_zircon_voice_lose"
msgstr ""
"קול הגילוי: טעמת הפסד, ארגון, ועכשיו החלקים מתחילים להתחבר. ההיעלמות של אורורה היא לא מקרה...\n"
" וגם זה שיצאת מזה בשלום. הדרך קדימה חשוכה יותר ממה שנדמה, אבל צריך ללכת בה.\n"
" לשים עין על ההיכל. לשים עין על ההרים. האמת מחכה... למי שמעז לראות אותה."

msgid "eclipse_zircon2_win"
msgstr ""
"בלתי אפשרי… נאחזת באידיאלים, ובכל זאת עמדת מולי. אולי לא הבנתי כמה כוח יש "
"באמונה."

msgid "eclipse_zircon3_win"
msgstr "ניצחון בדו-קרב הוא לא ניצחון בסיפור, ארגון. הסוף כבר התחיל."

msgid "eclipse_zircon_voice_win"
msgstr ""
"קול הגילוי: עמדת מול הכוח, ארגון - ועכשיו המסך מתחיל לעלות. השביל של אורורה עוד לא התקרר.\n"
" ההיכל צופה, אבל גם אחרים. האמת זזה. כדאי ללכת אחריה לפני שהיא נעלמת."

msgid "eclipse_cathedral_jada1"
msgstr ""
"אה, סוף סוף התעוררת. ספגת מכה לא קטנה מ... המדען זירקון? הוא היה אורח כאן - אדם מפחיד, אבל מכובד.\n"
" אין מה לדאוג, בהיכל עובדים ביסודיות; דאגנו לייצב את המצב שלך."

msgid "eclipse_cathedral_jada2"
msgstr ""
"ולגבי הבנק... מהומה נוראית. אומרים שהמנכ\"לית אורורה נעלמה מיד אחרי הדו-קרב. בלי להשאיר שום סימן.\n"
" השלטונות קוראים לזה 'משבר אמון'. זה כל מה שאני יודעת."

msgid "eclipse_cathedral_jada3"
msgstr ""
"נשמע שיש לך הרבה רגשות עכשיו. רק להיזהר במה שאומרים, ארגון. לקירות כאן יש אוזניים, וההיכל לא אוהב קצוות פתוחים.\n"
" עכשיו כדאי להתרכז בהחלמה."

msgid "eclipse_event10_1"
msgstr ""
"זירקון... ההיכל... אורורה. הוא דיבר על תוצאות, ועכשיו אורורה נעלמה. השתמשו בי כדי להסיח את הדעת.\n"
" צריך למצוא אותה, ולחשוף אותם."

msgid "eclipse_event10_2"
msgstr ""
"קול הספק: זה גדול מדי, ארגון. הם ימעכו אותך ואת האידיאלים שלך כמו את Chrome "
"Robo. כדאי ללכת לפני שגם אותך יקברו."

msgid "eclipse_event10_3"
msgstr ""
"קול החמלה: אורורה נאבקה על העצמאות של טוקסוולט, מול חמשת עמודי התווך של ההיכל.\n"
" היא נאבקה על משהו אמיתי. אסור לתת להם למחוק אותה."

msgid "eclipse_event10_4"
msgstr ""
"קול הגילוי: הדרך קדימה חשוכה יותר ממה שנדמה. ההיעלמות של אורורה היא לא מקרה... וגם זה שיצאת מזה בשלום.\n"
" לשים עין על ההיכל. לשים עין על ההרים. האמת מחכה... למי שמעז לראות אותה."

msgid "eclipse_event10_5"
msgstr ""
"ההיכל וההרים. המתקן הסודי חייב להיות שם, קשור לפרויקט ליקוי.\n"
" אלך בעקבות השביל עד הר האריה. הפעם אין בריחה."

msgid "eclipse_cathedral_enforcer1"
msgstr ""
"כבר הולכים? ההיכל מעריך את העסקים איתך.\n"
" רק לזכור: בזמני 'משבר', תמיד בטוח יותר לתת לשלטונות לטפל בדברים.\n"
" במיוחד בכל מה שקשור למנכ\"לית של טוקסוולט. יום טוב."

msgid "eclipse_crystal_hiker1"
msgstr ""
"אה, טרהפורם יזמים? כן, אני מכיר אותם. הם כל הזמן סוחבים ציוד כבד במעלה השביל הישן.\n"
" השביל הזה מוביל לתחתית הר האריה."

msgid "eclipse_crystal_hiker2"
msgstr ""
"לאחרונה הם הקימו גדר אבטחה ענקית, ליד המקום שבו הייתה תחנת המים הישנה, באמצע הדרך למעלה.\n"
" אומרים שהם בונים שם משהו 'ניסיוני' בשביל מחלקת נמרוד של ההיכל.\n"
" אני לא הייתי מתקרב לשם."

msgid "eclipse_event11_1"
msgstr ""
"קול האתגר: בחרת בשביל ההר, ארגון. הוא תלול, והאוויר דליל.\n"
" שם למעלה יש רק אותך, את הנגמונים שלך ואת התשובות שהכי מפחידות אותך. נראה אם יהיה לך כוח לעמוד כשהאמת תגיע לפסגה."

msgid "eclipse_event12_1"
msgstr ""
"קול הזיכרון: האוויר כאן נקי, אבל הידיים שלך לא, ארגון.\n"
" כל צעד למעלה הוא עוד צעד הרחק ממה שהרסת."

msgid "eclipse_event12_2"
msgstr ""
"קול הספק: זו משימה חסרת סיכוי. מטפסים על הר שבנוי על סודות.\n"
" אורורה לא נמצאת כאן; יש כאן רק מערה ריקה."

msgid "eclipse_event12_3"
msgstr ""
"קול החוכמה: לפסגה לא מגיעים כשמסתכלים עליה, אלא כשמתרכזים בצעד הבא.\n"
" להמשיך ללכת, ארגון."

msgid "eclipse_event13_1"
msgstr ""
"קול האתגר: השביל נהיה צר כאן. זירקון היה חזק ממך.\n"
" נראה אם הטיפוס הזה ישבור אותך לפני שהאמת תשבור."

msgid "eclipse_event13_2"
msgstr ""
"קול הפיתוי: תחנת המים הישנה הציעה נוחות וכוח. כדאי לחזור. למצוא פשרה.\n"
" מאבק בהיכל רק מעייף."

msgid "eclipse_event13_3"
msgstr ""
"קול קר: נכנסת לשטח פרטי, ארגון. נמרוד שומר היטב על הרכוש שלו.\n"
" ההר הזה שייך למי שיש לו את הכוח לקחת אותו."

msgid "eclipse_event14_1"
msgstr ""
"קול מהורהר: תראו כמה קטנה העיר עכשיו. כאן יש לך רק את עצמך.\n"
" אם יקרה משהו, אף אחד לא יידע, ואף אחד לא ישים לב."

msgid "eclipse_event14_2"
msgstr ""
"קול השיפוט: חיפשת צדק, אבל הבאת בלגן.\n"
" באמת חשבת שהאידיאלים שלך יחזיקו בגובה הזה? הם קפואים לגמרי."

msgid "eclipse_event14_3"
msgstr ""
"קול החמלה: האוויר דליל, אבל המטרה שלך ברורה. הגעת קרוב, ארגון.\n"
" אסור לתת לשקט הקר לכבות את האור שבך."

msgid "eclipse_event15_1"
msgstr ""
"הד מהעבר: פעם בנית דברים ביחד עם זירקון. עכשיו תראו מה הם בונים: מכרות, חומות ושקט.\n"
" זו התוצאה שרצית?"

msgid "eclipse_event15_2"
msgstr ""
"קול לוחש: לא לדבר על המנהרות. לא לדבר על המכסות של שאפט.\n"
" לאדמה כאן יש אוזניים, והשומרים הם הטובים ביותר של נמרוד."

msgid "eclipse_event15_3"
msgstr ""
"קול הפיתוי: ההר הוא רק סלע. האנשים הם רק עובדים.\n"
" לכל דבר יש מחיר, ארגון. מה המחיר שלך? שאפט מחפשים עובדים."

msgid "eclipse_event15_4"
msgstr ""
"קול לא מוכר: המכרה עמוק, אבל המטרה עמוקה יותר. הם לא כורים מינרלים; הם מכסים עקבות.\n"
" ללכת אחרי האדמה הכהה."

msgid "eclipse_park_welcome"
msgstr ""
"ברוכים הבאים לפארק הפלפל. הכניסה עולה ${{currency}}500. מקבלים 25 כדורי "
"לכידה של הפארק. מוכנים?"

msgid "eclipse_park_assistant"
msgstr "ברוכים הבאים!"

msgid "eclipse_park_guardian1"
msgstr "רוצים להפסיק את החוויה?"

msgid "eclipse_park_guardian2"
msgstr "ראיתם גדמי עצים?"

msgid "eclipse_park_guardian3"
msgstr ""
"כריתת עצים לא חוקית. השלטונות הבטיחו לעצור אותה, אבל זה נשאר רק על הנייר. בפועל הם לא הצליחו.\n"
"אין לי אמון שהשלטונות ישמרו על היערות ועל הסביבה. אנחנו צריכים לקחת את העניין לידיים."

msgid "eclipse_park_guardian4"
msgstr "זה מגעיל!"

msgid "eclipse_park_guardian5"
msgstr "נראה לכם שיש לנו ביוב ומכוני טיהור בתוך פארק?!"

msgid "eclipse_park_nomoney"
msgstr "אוי, אין מספיק כסף!"

msgid "eclipse_park_yesmoney"
msgstr "תיהנו מהחוויה!"

msgid "eclipse_park_steps100"
msgstr "נשארו עוד 100 צעדים!"

msgid "eclipse_park_scientist1"
msgstr ""
"הרבה פארקים מגבילים או אוסרים מחקר מדעי, אבל אנחנו בחזית הידע על הטבע!"

msgid "eclipse_park_tennisplayer1"
msgstr "מחזיקים אצבעות שהמפגש הבא יהיה עם נגמון ידידותי!"

msgid "eclipse_park_professor1"
msgstr ""
"יש גדרות למבקרים, אבל אין גדרות סביב הפארק בשביל המפלצות. ככה פארק צריך "
"להיות."

msgid "eclipse_park_soldier1"
msgstr "נראה לי שהפארק הצליח די טוב להיות חבר של כולם."

msgid "menu_park_summary"
msgstr "סיכום הפארק"

msgid "menu_park_seen"
msgstr "נגמונים שונים שנראו"

msgid "menu_park_total"
msgstr "סך הכול ניסיונות"

msgid "menu_park_capture"
msgstr "תפיסות מוצלחות"

msgid "menu_park_failed"
msgstr "ניסיונות שלא הצליחו"

msgid "menu_park_success_rate"
msgstr "אחוז תפיסות מוצלחות"

msgid "menu_park_sighting"
msgstr "נראו הכי הרבה פעמים"

msgid "menu_park_no_sighting"
msgstr "עוד לא נרשמו תצפיות."

msgid "menu_park_highlights"
msgstr "רגעים מיוחדים במפגשים"

msgid "menu_park_no_highlights"
msgstr "עוד לא נרשמו מפגשים."

msgid "menu_park_thanks"
msgstr "תודה שטיילתם בפארק!"

msgid "menu_park_afraid"
msgstr "{user} נרתע לאחור, מתוח ומוכן לברוח."

msgid "menu_park_stare"
msgstr "{user} מסתכל ישר אליך, שקט ובלי הבעה."

msgid "menu_park_wander"
msgstr "{user} זז לאט, שקוע במחשבות."

msgid "menu_park_resting"
msgstr "{user} מתכרבל, ונושם לאט ובשקט."

msgid "menu_park_playful"
msgstr "{user} מתרוצץ מסביב ומעיף אבק מרוב התרגשות."

msgid "menu_park_alert"
msgstr "{user} נעצר פתאום, מרגיש שמשהו קרוב."

msgid "aardart_description"
msgstr "הוא סופר כל נמלה שאכל, וחוגג כשמגיע למספר עגול."

msgid "aardorn_description"
msgstr "כשהוא נולד, מניחים אותו בתוך גבעת נמלים, והוא אוכל את דרכו החוצה."

msgid "abesnaki_description"
msgstr ""
"לכל פרצוף יש דוגמה אחרת. יש אומרים שהסמלים יוצרים מילים בשפה עתיקה שכבר אף "
"אחד לא מדבר."

msgid "agnidon_description"
msgstr ""
"הוא מעדיף ללכת על ארבע, אבל יכול לעמוד על שתיים כדי לפתוח דלתות, להפיל עצים "
"או להחזיק דברים."

msgid "agnigon_description"
msgstr ""
"קוראים לו \"דרקון מזויף\", כי הוא נראה כמו דרקון, אבל בעצם התפתח מענף אחר של"
" זוחלים עתיקים."

msgid "agnite_description"
msgstr "הוא שובב, אבל צריך ללמד אותו מגיל צעיר לשמור על האש שלו בשליטה."

msgid "allagon_description"
msgstr ""
"Allagon נמשכים לשרידים עתיקים שעשויים מהמתכות של אבותיהם, ויעשו הכול כדי "
"להחזיר אותם."

msgid "altie_description"
msgstr ""
"Altie ירד לכדור הארץ בתוך בועה. עכשיו הבועה שלו התפוצצה, והוא לא יכול לרחף "
"יותר מכמה מטרים באוויר."

msgid "ambuwl_description"
msgstr ""
"הביצה שבכיס שלו אף פעם לא בוקעת. במקום זה היא מפרישה משקה טעים שמחזיר כוחות."

msgid "ampystoma_description"
msgstr ""
"הצבעים הבוהקים של Ampystoma נועדו להזהיר, אז קשה להאמין שהוא מצליח להפתיע "
"מישהו. אבל המים העכורים שבהם הוא צד מסתירים אותו עד שהוא מחליט להופיע. הוא "
"אוהב לצאת ליבשה בזמן סופות רעמים."

msgid "angesnow_description"
msgstr ""
"אנשים שהלכו לאיבוד בקור מקפיא וחזרו בשלום מספרים לפעמים על נוכחות מסתורית "
"שהדריכה אותם, גם כשהשלג היה כבד מכדי לראות משהו."

msgid "angrito_description"
msgstr ""
"Angrito לא מבין למה בני אדם מרגישים כעס עצום, אבל גם הוא מרגיש אותו לפעמים."

msgid "anoleaf_description"
msgstr "הוא מחשיב את הצמחים שגדלים לידו לאחים ולאחיות שלו."

msgid "anu_description"
msgstr "אומרים שהוא נכנס לחלומות של אחרים כדי לחפש חבר יקר שאבד לו."

msgid "apeoro_description"
msgstr ""
"מלכים עתיקים השתמשו בכוחות על-חושיים כדי להעביר את הנשמה שלהם למכונות החישוב"
" המוזהבות האלה. עכשיו הם ממשיכים להתקיים, לא יכולים לדבר, אבל עדיין חולמים "
"על ממלכות."

msgid "araignee_description"
msgstr ""
"מי שמתעקשים שלכל עכביש יש 8 רגליים, משום מה שותקים כשמדברים על Araignee."

msgid "arthrobolt_description"
msgstr ""
"לא נוח לו לתת פקודות לחבריו Nut ו-Bolt, ולכן הוא בדרך כלל בורח. אבל אז ל-Nut"
" ול-Bolt אין מי שיגיד להם מה לעשות."

msgid "askylpaws_description"
msgstr ""
"הוא סימן לאסון, ומופיע לעיתים קרובות בזמנים קשים. בגלל זה יש שמאשימים אותו "
"בצרות עצמן."

msgid "asudopt_description"
msgstr ""
"לפי האגדה, Asudopt יצר את העולם, ויום אחד גם יפרק אותו. בינתיים הוא קובע את "
"חוקי הטבע של העולם."

msgid "av8r_description"
msgstr "כשהשמש בחוץ, הוא יכול לעוף רחוק או גבוה כמה שהוא רוצה."

msgid "axolightl_description"
msgstr "הוא מאיר את המים העמוקים בזנב שלו, ומסמן לדגים מקום מחסה בטוח."

msgid "b_ver_1_description"
msgstr "הוא תוכנן בשביל כל הפעמים שבהן צריך שרובוט ינשוך משהו."

msgid "babysnitch_description"
msgstr ""
"Babysnitch הכועס זורק את עצמו למתקפה, בדרך כלל בלי הרבה הצלחה. אבל זהירות: "
"מי שצוחק על הניסיונות שלו, ייאלץ להתמודד איתו כשיגדל ל-Baddrscratch."

msgid "baddrscratch_description"
msgstr ""
"Baddrscratch הזועם הוא צייד מפחיד, והוא לא מפסיק לרדוף אחרי הטרף שלו, גם "
"כשהסכנה גדולה מאוד."

msgid "bamboon_description"
msgstr ""
"הוא מתמודד בדו-קרבות עם מקל הבמבוק שלו, שבו הוא משתמש גם כדי לשמור על שיווי "
"משקל."

msgid "banling_description"
msgstr "כל Banling מחכה שרוח חסרת בית תבוא להתכרבל בענפים שלו."

msgid "bansaken_description"
msgstr ""
"כשמחשיך, הרוחות שבתוך Bansaken מתעוררות. הן אוהבות להבהיל ילדים שובבים שלא "
"הולכים לישון בזמן."

msgid "banvengeance_description"
msgstr ""
"Banvengeance רוצה ליצור לילה משלו: הוא מגדל עצים חדשים משורשים זוחלים כדי "
"לחסום את האור, ולא משאיר מקום לצמחים אחרים."

msgid "baobaraffe_description"
msgstr ""
"הוא אוגר כמויות עצומות של מים בגוף הענק שלו, כדי שיוכל לנדוד רחוק במדבריות "
"חמים ויבשים. הוא גם חולק מים עם יצורים צמאים. כשאין בו מים, הוא רזה."

msgid "baoby_description"
msgstr ""
"הם נודדים מנהר לנהר כדי למצוא מים לשתות ולאגור. הקרניים המכוסות עלים שעל "
"הראש שלו מסתירות קצוות זזים שעוזרים לו לגלות איפה יש מים. בזמן בצורת, הרבה "
"יצורים הולכים אחרי Baoby."

msgid "bedoo_description"
msgstr ""
"הוא מרדים את הטרף שלו בשינה עמוקה לכמה שעות, ובינתיים נהנה לאכול את החלומות "
"שלו. לפעמים, בטעות, השינה נמשכת ימים שלמים."

msgid "beenstalker_description"
msgstr ""
"מה שחסר ל-Beenstalker בשכל ובחן, הוא משלים בהתלהבות ובלב טוב. הוא נהנה "
"להבריח מזיקים, אבל אף פעם לא פוגע בהם."

msgid "bewhich_description"
msgstr ""
"כש-Bewhich עוצר את הנשימה, הוא יכול להיראות כמו אדם יפה, אבל קצת מאיים. "

msgid "bigfin_description"
msgstr ""
"על הגב שלו חיה מערכת אקולוגית שלמה, ולכן הוא משתדל לא לצלול מתחת למים."

msgid "birdee_description"
msgstr ""
"הוא אוכל הכול, אבל אם הוא מעדיף בשר או זרעים תלוי במה שחווה כשהיה צעיר."

msgid "birdling_description"
msgstr ""
"יש מי שחושבים שהוא נושא את הביצה של עצמו על הגב. אבל בעצם הוא שומר על ביצה "
"חשובה הרבה יותר."

msgid "bishosand_description"
msgstr ""
"Bishosand מוקסם מסמלים מיוחדים מכל מיני תרבויות, ואוהב לאסוף אותם, אבל נראה "
"שהוא לא מבין אף אחד מהם."

msgid "blasdoor_description"
msgstr ""
"Blasdoor מגינים על מי שיקר להם מאחורי הגוף העבה שלהם, שאי אפשר לעבור דרכו. "
"מכונות גרוטאה הם טוחנים בשיני הפלדה שלהם, ופולשים הם מגרשים בלי היסוס."

msgid "bolt_description"
msgstr "כש-Bolt נמצא בסביבה, Nut מתהדק חזק יותר ומפיק יותר ניצוצות של אנרגיה."

msgid "boltnu_description"
msgstr ""
"רוב הזמן הוא חופר מחילות באדמה, והרעידות והתנועה הבלתי פוסקות של החפירה "
"משאירות אותו מסוחרר תמיד."

msgid "botbot_description"
msgstr "הוא רובוט אוניברסלי שאפשר להתאים לכל מטרה."

msgid "boxali_description"
msgstr ""
"בעזרת הגלימה הכחולה והארוכה שלו, Boxali יכול לדאות מעל הקרקע, לעשות פעלולים "
"ולתקוף מהאוויר."

msgid "boxorox_description"
msgstr "ככל שהוא נעשה פחות חכם, גוף הסלע שלו נעשה קשה יותר."

msgid "brachifor_description"
msgstr "Brachifor יכול להסתדר בלי לאכול, אם הוא נשאר בלי לזוז בכלל."

msgid "breem_description"
msgstr ""
"בלילה הוא מנקב פירות ומכניס לתוכם Duggot חדשים. ביום הוא מעמיד פנים שהוא "
"דבורה רגילה."

msgid "brewdin_description"
msgstr ""
"הוא נולד בכלי חרס ובאוצרות אחרים שפעם היו יקרים, ואז נשכחו. אומרים שהוא "
"מגשים משאלות למי שמצליח להצחיק אותו."

msgid "bricgard_description"
msgstr ""
"כשהחורף מגיע, Imbrickcile בונה לעצמו גולם מלבנים כדי להגן על עצמו מטורפים."

msgid "brickhemoth_description"
msgstr ""
"כדאי להיזהר לפני שבועטים בקן של Bricgard: מכה חזקה היא בדיוק מה שהנגמון צריך"
" כדי לפרוץ החוצה, כשהוא כבר הפך ל-Brickhemoth."

msgid "brumi_description"
msgstr "Brumi לוקח מטאטאים שאף אחד לא משתמש בהם. "

msgid "budaye_description"
msgstr ""
"הוא יכול לשכנע כל קבוצה לשתף פעולה למען כולם, בעזרת כמה יללות מעודדות "
"ונפנופי יד."

msgid "bugnin_description"
msgstr "החרב שלו היא בעצם מחוש שהוא מגדל ושובר במיוחד בשביל זה."

msgid "bumbulus_description"
msgstr ""
"Bumbulus הוא יצור מעופף שמפיק ענן עשן כדי להתחפש לענן. אף אחד עוד לא ראה את "
"הגוף האמיתי שלו."

msgid "burrlock_description"
msgstr "Burrlock אוהב להידבק לעוברים ושבים, וכך הוא נודד ממקום למקום."

msgid "bursa_description"
msgstr "הוא חושב שאש רגילה היא פשוטה מדי, ולכן מייצר רק את האש של המחשבה."

msgid "cacaburr_description"
msgstr ""
"Cacaburr עוזר להרבה מאביקים כמו Tumblebee, ולאוהבי זרעים כמו Chickadee."

msgid "cackleen_description"
msgstr ""
"יש אומרים ש-Cackleen הוא ילד שרוח שובבה נכנסה בו, ואחרים אומרים שהוא רוח של "
"ילדה שהלכה לאיבוד. "

msgid "cairfrey_description"
msgstr "רהיט עליז שהתעורר בוקר אחד והחליט לצאת לחקור."

msgid "caper_description"
msgstr ""
"Caper משחקים ומשתובבים זה עם זה בין הקצף של נהרות ההרים, הקרים כמו קרח."

msgid "capinyah_description"
msgstr ""
"רק אחרי אימון קשה בג'ונגל, עם הרמת בולי עץ וסלעים מהנהר, Capiti יכול לסיים "
"את ההכשרה ולהפוך ל-Capinyah."

msgid "capiti_description"
msgstr "הוא נראה כמו תינוק, אבל נמצאו כמה כאלה שהם בני מאות שנים."

msgid "carcharock_description"
msgstr ""
"האינסטינקטים העתיקים של Carcharock לא מסתדרים עם העולם המודרני, שבו הריח של "
"Pharfan והשאגה של Pantherafira החליפו את הקולות המוכרים של מולדתו."

msgid "cardiling_description"
msgstr "אף אחד לא מצפה שהוא יירק אש, עד שזה קורה."

msgid "cardinale_description"
msgstr ""
"הוא לא סובל טורפים, ומנסה לגרש אותם, וגם את הצאצאים שלהם, בכל הזדמנות."

msgid "cardiwing_description"
msgstr "השיר שלו מדהים, אבל מעטים מעזים לגדל ציפור שיר שמתפוצצת."

msgid "cataspike_description"
msgstr ""
"הוא לומד להתמודד מצפייה באחרים. כשמשאירים אותו לבד, הוא משתמש בקוץ שלו כדי "
"לאסוף זבל."

msgid "cateye_description"
msgstr "אומרים שהוא ממצמץ פעם אחת בשנה, לכבוד סוף הקיץ."

msgid "chenipode_description"
msgstr "כשהוא רוצה לנסוע, הוא נאחז בשיניים בשרוכים ובמכנסיים של מישהו."

msgid "cherubat_description"
msgstr ""
"העטלפים הסקרנים האלה נמשכים לרגשות חזקים של שמחה וחגיגה, ולוקחים זרי פרחים "
"וקופסאות שוקולד שאף אחד לא שומר עליהם, כדי לבנות מהם קן."

msgid "chibiro_description"
msgstr "מוצאים אותו ביערות ובשדות, ולעיתים קרובות מתבלבלים בינו לבין לפת."

msgid "chickadee_description"
msgstr ""
"Chickadee משמיע קריאות \"די\" ארוכות וחוזרות, כשהסכנה שהוא מרגיש נראית קטנה "
"יותר מסכנה אחרת."

msgid "chillimp_description"
msgstr ""
"אומרים שהוא חי על פסגות הרים מושלגים, אבל עוד אף אחד לא הצליח לצלם אותו "
"בבירור."

msgid "chloragon_description"
msgstr ""
"הוא בוקע כששותלים ביצה עתיקה באדמה פורייה. כשהביצים ייגמרו, לא יהיו יותר "
"Chloragon."

msgid "chromeye_description"
msgstr "Chromeye נבנה כדי לצפות בבני אדם וללמוד איך הם חושבים ומרגישים."

msgid "claymorior_description"
msgstr "אומרים שרק אחד מכל 1000 יכול לשלוט ב-Claymorior בתור Regalance."

msgid "coaldiak_description"
msgstr "הדוב הזה יכול להצית אש בכל מקום, ולהשאיר סימני טפרים על כל דבר."

msgid "cobarett_description"
msgstr ""
"הוא עוטף את עצמו בעשן סמיך כדי לגלוש בקלות דרך שיחים צפופים. מקור העשן הוא "
"חום הגוף הלוהט שלו, שהוא כל כך גבוה שלשונות להבה יוצאות לו מהפה."

msgid "cochini_description"
msgstr "הוא חכם ומודע כמו ילד בן 3, ואוהב ממתקים בדיוק כמו ילד בן 3."

msgid "cocrune_description"
msgstr "לאן שלא יסתובב, העין האדומה שלו תמיד מסתכלת עליך."

msgid "cohldrabi_description"
msgstr "הוא נולד מתחת לאדמה באזורים קרים ומושלגים, ולומד לעוף תוך כמה שבועות."

msgid "coleorus_description"
msgstr "הוא קיים כבר מיליוני שנים, בלי להשתנות בכלל."

msgid "conglolem_description"
msgstr "הג'ל שבו התייבש כבר מזמן, אבל Conglolem ממשיך הלאה."

msgid "conifrost_description"
msgstr "כשהוא מתעטש, מתחילה מפולת שלגים. ויש לו נזלת כל הזמן."

msgid "conileaf_description"
msgstr "מזון שמניחים בכד שלו מתערבב ונכבש. כך אפשר לשמור אוכל בלי שיתקלקל."

msgid "coppi_description"
msgstr ""
"הפרחים של Coppi מרים ומסריחים באופן מפתיע, אבל הם שימושיים בהכנת משקאות "
"ותרופות."

msgid "coproblight_description"
msgstr ""
"הוא נולד מגללים מאובנים של נגמונים מהתקופה הקדומה, והשתמש בשברי העצמות "
"שבתוכו כדי להגן על עצמו."

msgid "corvix_description"
msgstr "הוא מחזק את הכנפיים שלו בשברי עצמות שהוא מוצא."

msgid "cowpignon_description"
msgstr "יש אנשים שמייבשים אותו ומשתמשים בו כתרופה."

msgid "crankus_description"
msgstr ""
"מפסגה לפסגה אפשר לשמוע את Crankus פועים זה על זה בוויכוחים שלא נגמרים, עד "
"שהשלג מפשיר באביב."

msgid "criniotherme_description"
msgstr "הרעמה שלו זוהרת ביום, גדלה ומאדימה בשקיעה, ובלילה עפה ברוח כמו אפר."

msgid "crustagu_description"
msgstr ""
"הוא יורה קוצים חדים ורעילים מהצבתות שלו, כדי להבריח את מי שמאיים על המושבות "
"שלו מתחת למים."

msgid "dandicub_description"
msgstr ""
"אחרי שהגורים נולדים, הם מרחפים לכל קצות העולם, ונדיר שהם פוגשים שוב את "
"המשפחה שלהם."

msgid "dandylion_description"
msgstr ""
"הוא יולד גורים רק פעם אחת בחייו. אחר כך הוא נודד בעולם ומנסה למצוא אותם."

msgid "dankush_description"
msgstr ""
"Dankush יכול למנוע מעצמו להישרף אם הוא עוצר את הנשימה, ואז ענני עשן יוצאים "
"מכל אחד מהעלים שלו."

msgid "delfeco_description"
msgstr ""
"הגוף החלק של Delfeco מאפשר לו לשחות מהר, ושיטות הציד המתוחכמות שלו מראות כמה"
" הוא חכם. למרות הגודל שלו, הוא ידוע כשובב, ויש לו קשר חזק עם המאמן שלו."

msgid "demosnow_description"
msgstr ""
"Demosnow נהנים לפתות מטיילים להיכנס עמוק לטבע הפראי, יותר ממה שבטוח, "
"ומבטיחים להם תהילה והרפתקאות."

msgid "devidin_description"
msgstr ""
"דיקינודונט, זוחל קדום, שחזר לחיים והחליט להפוך לדינוזאור שכולם תמיד חושבים "
"בטעות שהוא."

msgid "devidra_description"
msgstr ""
"כדאי להסתכל מקרוב: פרווה דקיקה מסגירה שהוא רק מעמיד פנים, בשובבות, שהוא "
"דינוזאור."

msgid "deviraptor_description"
msgstr ""
"זוג הנוצות היחיד שעל הראש שלו מזויף, וזה רמז לזהות האמיתית והשובבה שלו."

msgid "dinoflop_description"
msgstr ""
"Dinoflop נהנה להסתובב מהר ממי שתוקף אותו, כך שהמכות נוחתות על הגב המוגן "
"והקוצני שלו."

msgid "djinnbo_description"
msgstr ""
"יש מי שחושבים בטעות שפעם הוא היה בן אדם שנלכד בשריפה. האמת היא שהוא פשוט "
"נולד בתוך להבה."

msgid "doctsky_description"
msgstr ""
"הצבוע הקטן רק רוצה לטפל באחרים, אבל יש לו שם רע מאז שיצא סרט שבו הוא היה "
"הנבל."

msgid "dollfin_description"
msgstr "כל אחד מהם הולך אחרי ספינה ממקום למקום, וכך חוקר את העולם."

msgid "dracune_description"
msgstr "ביום הוא לא זז בכלל, אבל בלילה הוא יכול להתפתל ולנשוך."

msgid "dragarbor_description"
msgstr ""
"כשהוא מרגיש שהוא זקן מאוד, הוא נודד למקום שקט ושותל את עצמו באדמה. הפרח "
"שבזנב שלו ממשיך לגדול לנצח."

msgid "drashimi_description"
msgstr ""
"הוא שוכב על הקרקע, מריח טעים ומפתה מפלצות לנגוס בו. אבל כשהן מתקרבות, הוא "
"נוגס בהן קודם."

msgid "drokoro_description"
msgstr ""
"פעם הייתה לו משפחה, אבל הוא היה כל כך רעב שאכל את כל האוכל של כולם, עד שכולם"
" עזבו והוא נשאר לבד."

msgid "duggot_description"
msgstr ""
"כש-Tumblebee מנסה לשתות מיץ פירות, Duggot עלול להיצמד אליו ולהתחיל לשלוט בו."

msgid "dune_pincher_description"
msgstr ""
"סרטני הנזיר האלה עוטפים את עצמם במה שהכי קרוב אליהם. במדבר, אלה התחבושות "
"העתיקות של פרעונים קדומים."

msgid "eaglace_description"
msgstr "כשהוא ממריא, נוצרים עננים. כשהוא מוחא בכנפיים, יורד ברד."

msgid "elofly_description"
msgstr "Elofly לבד הוא סבלני וחכם, אבל כשהוא בלהקה גדולה הוא נעשה פראי ופזיז."

msgid "elostorm_description"
msgstr "מלכים ומלכות: Elostorm שולטים בעם שלהם, ויש להם שאיפות גדולות."

msgid "elowind_description"
msgstr "הסגנים של משפחת Elofly. Elowind רועים את הלהקה ושומרים שתישאר מרוכזת."

msgid "embazook_description"
msgstr "הוא אומן כל חייו לדו-קרבות, ולא מכיר שום דבר אחר."

msgid "embra_description"
msgstr "הוא אוכל כל מה שהוא יכול, כדי לגדול מספיק ולהפוך ל-Ruption."

msgid "enduros_description"
msgstr ""
"Enduros הוא מתאגרף נלהב שלא מרכך את המכות שלו. מחוץ לזירה, הוא דווקא מאוד "
"חברותי."

msgid "equill_description"
msgstr "המרירות שלו גורמת לו להשתנות. הוא מסתיר את הכיעור שלו בחושך."

msgid "eruptibus_description"
msgstr "נפחים עובדים איתו, ומחממים מתכות בלוע הוולקני שלו."

msgid "erythroskyte_description"
msgstr ""
"יש לו אופי ידידותי, אבל הזנב שלו, שנראה כמו מזרק ענק, מבהיל הרבה אנשים."

msgid "eskipup_description"
msgstr "גם כשהוא גור, הוא יכול למשוך משא של 1 טון."

msgid "exapode_description"
msgstr "הוא מנפנף ברגליים כדי למשוך תשומת לב, אבל בדרך כלל אנשים פשוט בורחים."

msgid "exclawvate_description"
msgstr ""
"רואים אותם הרבה באתרי בנייה. הם גורפים עפר והריסות בידיים הענקיות ובזנב "
"שלהם. מתחת לנגמון יש זחלים כמו של טרקטור, שנותנים לו שיווי משקל ואחיזה טובה "
"כשהוא מטפס על ערימות הריסות."

msgid "eyenemy_description"
msgstr "הוא ניזון מנופים יפים ומכל מראה מרהיב אחר."

msgid "eyesore_description"
msgstr "הוא זוכר כל מה שראה אי פעם, אבל לא את הסדר שבו ראה את הדברים."

msgid "fancair_description"
msgstr ""
"אם מישהו משאיר מאוורר דולק כשהוא לא צריך אותו, המאוורר מתעורר לחיים ועף "
"מהחלון למצוא מישהו שבאמת צריך צינון."

msgid "ferricran_description"
msgstr ""
"פעם, Ferricran היו מכוסים כולם בקשקשים בלתי שבירים, והיו להם כנפיים ממתכת "
"קסומה."

msgid "firomenis_description"
msgstr ""
"הנגמונים האלה גדולים וחזקים אחרי שנים רבות שבהן היו Merlicun. הלסתות שלהם "
"יכולות לפצח עצים שלמים, והם עפים כל כך חזק שהם יכולים לשאת אנשים."

msgid "flacono_description"
msgstr "הוא לא מפחד בכלל מיריבים, ויתמודד עם יריב בכל גודל בלי לחשוב פעמיים."

msgid "flambear_description"
msgstr ""
"אפשר לעקוב אחריו לפי שביל של שיחי פירות יער מבושלים ודגי פורל צלויים שהוא "
"משאיר אחריו."

msgid "flisces_description"
msgstr ""
"הוא גולש על פני המים בלי שיבחינו בו, עד שקפיצה חזקה מפעילה את הסנפירים החדים"
" שלו."

msgid "fluoresfin_description"
msgstr ""
"כשמאיימים עליו, הוא מתקבץ עם Fluoresfin אחרים כדי ליצור אור גדול ומסנוור "
"שמבלבל טורפים."

msgid "fluttaflap_description"
msgstr "הוא אוכל רק את הלכלוך, כך שמי שהוא ננעץ בו יוצא נקי ובריא יותר."

msgid "foofle_description"
msgstr "כשאחד מהם בסכנה, כל ה-Foofle שומעים את הקריאות שלו, לא משנה איפה הם."

msgid "flounce_description"
msgstr ""
"Flounce יכול להיות עקשן ולבדן, ולעקוף את כל החוקים, אלא אם יש לו מוטיבציה "
"טובה."

msgid "flummack_description"
msgstr ""
"Flummack כבר לא רוצה שיאכלו אותו, אלא לאכול בעצמו. אפילו Flummby ו-Flummack "
"אחרים נראים לו טעימים."

msgid "flummby_description"
msgstr ""
"את Flummby המציא מדען שחשב שאוכל שרוצה שיאכלו אותו יהיה הוגן יותר. הוא קופץ "
"לתוך הפה של כל מי שיכול לאכול אותו."

msgid "fordin_description"
msgstr "כשמאיימים עליו, הוא מתכרבל לכדור וקופץ משם."

msgid "forturtle_description"
msgstr "הוא מחמם את השריון שלו כדי לקרוא את העתיד בסדקים שנוצרים בו."

msgid "foxfire_description"
msgstr ""
"גורים של Foxfire נמצאים במדורות שכבו במהלך הלילה. אף אחד לא יודע מאיפה הם "
"באים."

msgid "fribbit_description"
msgstr "אומרים שפעם הוא היה ילד שליקק עמוד תאורה קפוא."

msgid "frondly_description"
msgstr ""
"הוא יכול לעשות הכול עם הזנב האוחז שלו, אפילו ללחוץ ידיים ולקטוף פירות."

msgid "frostuce_description"
msgstr "לא כל יום רואים משהו ירוק רוקד ואלס בסופת שלגים."

msgid "fruitera_description"
msgstr ""
"Fruitera חמדן לפירות, ונושא כמה שיותר מהם. כשהוא נבהל, הוא מפיל את כל "
"הפירות, אוסף את כולם בחזרה, ורק אז בורח."

msgid "furnursus_description"
msgstr ""
"Furnursus ידידותיים, ולעיתים קרובות שוכחים שהגוף שלהם חם מדי בשביל שאחרים "
"יגעו בו."

msgid "fuzzina_description"
msgstr ""
"כשהילד שעזב את Fuzzlet צריך אותו שוב, הוא הופך ל-Fuzzina: מגן אמיץ שדואג "
"לקטנים ולחלשים."

msgid "fuzzlet_description"
msgstr ""
"כשילד כבר לא נמצא בסביבה כדי לשחק עם הצעצועים שלו, לפעמים הם מתעוררים לחיים."

msgid "galasces_description"
msgstr "Galasces יכול לשנות את הצורה שלו כדי לעטוף טרף בגודל שלו."

msgid "galnec_description"
msgstr ""
"Galnec קובר את עצמו עמוק בחול החם של המדבר, ורק הזנב האבני שלו מציץ מעל "
"הקרקע. כשהם בלהקה, הם נראים כמו גן של אבנים."

msgid "gastronium_description"
msgstr ""
"Gastronium יכול לאכול כמעט כל דבר, אבל מעדיף חומרים כבדים ורדיואקטיביים."

msgid "gectile_description"
msgstr "הוא כל כך מהיר וקל שהוא יכול ללכת על עלים."

msgid "ghosteeth_description"
msgstr "הוא מחייך כי הוא יודע מה יקרה בעתיד לכל מי שהוא פוגש."

msgid "dynastor_description"
msgstr ""
"Dynastor הוא נגמון ענק דמוי חרק, עם שלד חיצוני עבה ומשוריין וכנפיים מיוחדות "
"לאורך הגב. הלסתות שלו יכולות למעוך פלדה. "

msgid "gliffary_description"
msgstr ""
"יצור פיות שובב שכמעט אף פעם לא רואים. הוא מתאסף ליד מעגלי פטריות, ומתיך ברזל"
" בהתלהבות."

msgid "glombroc_description"
msgstr ""
"הוא שומר את הזיכרונות שלו בשריון הסלעי. אם כמה מהם נופלים, הוא נעשה שכחן."

msgid "glomon_description"
msgstr ""
"מושבה של חיידקים שהפכה ליצור חדש בתוך כפפה רפואית שנזרקה. הוא יכול לראות דרך"
" הגב שלו."

msgid "golnagi_description"
msgstr ""
"הקשקשים של Golnagi זוהרים, ולכן הוא כמעט בלתי נראה במים בזריחה ובשקיעה, "
"הזמנים שבהם הוא הכי אוהב לצוד."

msgid "gourda_description"
msgstr ""
"בתחרויות לגידול ה-Gourda הכי גדול, היו כאלה שהגיעו למשקל של 1 טון. אבל "
"Gourda רגילים קטנים בהרבה."

msgid "graffiki_description"
msgstr ""
"Graffiki מרגישים בבית בעיר בדיוק כמו בג'ונגל, ומסמנים את השטח שלהם בציורים "
"מפוארים."

msgid "grimachin_description"
msgstr "חברת צעצועים בנתה אותו כחיית מחמד, אבל הוא יצא מסוכן מדי."

msgid "grinflare_description"
msgstr "אומרים שכל אחד מהם הוא הלב המהלך של הר געש."

msgid "grintot_description"
msgstr "הוא Grintrock או Grinflare שנשחק עם הזמן מרוח וממים."

msgid "grintrock_description"
msgstr "הוא ניזון כשהוא יושב בחוץ בסופות רעמים ומחכה שברק יפגע בו."

msgid "grumpi_description"
msgstr "מי שנתפס על ידי Grumpi, לא יכול להשתחרר מהגוף הדביק שלו."

msgid "gryfix_description"
msgstr "שריון עצם מגן על Gryfix מכל המתקפות, חוץ מהחזקות ביותר."

msgid "gupphire_description"
msgstr ""
"הקשקשים של Gupphire נוצצים, והוא מראה מהמם. דייגים שרואים Gupphire מאמינים "
"שיהיה להם מזל טוב כל השנה."

msgid "gupphish_description"
msgstr ""
"Gupphish אוהב לשחות בלהקות, ולכן הוא בחירה פופולרית אצל מאמנים שאוהבים עבודת"
" צוות."

msgid "hampotamos_description"
msgstr "הוא מכרסם בעדינות את Rinocereed, ומנקה ממנו עור מת, טחב ועשבים."

msgid "happito_description"
msgstr ""
"למה אנשים לא יכולים להיות תמיד שמחים? Happito ייתן להם בדיוק את מה שהם "
"רוצים, גם אם זה לא מה שהם צריכים."

msgid "hatchling_description"
msgstr ""
"כשביצה לא רוצה לבקוע ולהתחיל את השלב הבא בחייה, היא הופכת ל-Hatchling."

msgid "hectapod_description"
msgstr ""
"כשהוא מנפח את הכיפה שלו, הוא צף אל פני האוקיינוס, ואפילו מרחף דרך ערפל "
"ועננים."

msgid "helipi_description"
msgstr ""
"הוא עף רחוק יותר עם כנף אחת שמסתובבת מאשר עם שתיים, אבל קשה לו יותר לכוון."

msgid "heronquak_description"
msgstr ""
"ציידים לא חוקיים חושבים בטעות שהגביש שעל החזה שלו הוא יהלום. אבל הגביש נמס "
"כשמוציאים אותו מהגוף של Heronquak."

msgid "hissiorite_description"
msgstr ""
"בבסיס הצוואר שלו יוצא גז לוהט שעוטף את הגוף וגורם לו לרחף כמה סנטימטרים מעל "
"הקרקע, כמו כדור פורח. בזכות זה הוא נע מהר, אפילו מעל מים."

msgid "hoarse_description"
msgstr "הוא נראה כמו חיית משק, אבל הבעלים שלו לא התייחס אליו יפה."

msgid "hoarseshoo_description"
msgstr "זה מה שנשאר כשהצל של Equill בולע את הגוף שלו."

msgid "hoodoll_description"
msgstr ""
"לפעמים הוא תוקע בעצמו סיכה כדי להטיל כישוף על היריבים שלו, אבל אחר כך אף אחד"
" לא רואה שום הבדל."

msgid "hotline_description"
msgstr ""
"היצורים הסקרנים האלה קופצים למרחקים גדולים, ומשמיעים צליל מתכתי ומוזר שאי "
"אפשר לברוח ממנו, לא משנה כמה רחוק הטרף רץ."

msgid "houndice_description"
msgstr ""
"Houndice אוהב מזחלות, אבל הוא גם יודע לרחרח ולמצוא מטיילים שהלכו לאיבוד מתחת"
" לשלג."

msgid "howl_description"
msgstr ""
"מאחורי המראה המבולבל של Howl מסתתרת חוכמה עמוקה. אם רק היה יכול להסביר אותה!"
" אבל המילים שלו יוצאות כצפצופים ויללות."

msgid "hydrone_description"
msgstr "הוא משתמש בטכנולוגיה ניסיונית שמפיקה אנרגיה ממים."

msgid "ignibus_description"
msgstr ""
"כשמאיימים עליו, הוא נסוג לתוך השריון שלו ומתקרר מהר מאוד בעזרת שחרור אדים. "
"אפשר לחשוב בטעות שהוא סלע."

msgid "imbrickcile_description"
msgstr ""
"Imbrickcile מסתתרים בתוך לבנה אחת, ויוצאים רק כדי להרים אותה ולחזק את "
"השרירים."

msgid "incandesfin_description"
msgstr "כל הגוף שלו גדל מאוד. אבל האור שלו נשאר בדיוק אותו דבר."

msgid "jelillow_description"
msgstr ""
"כשמניחים את הראש על Jelillow, העור הג'לי שלו גורם לשקוע בשינה עמוקה. למי "
"שמתקשה להירדם, משתמשים במפלצת הזאת כדי לעזור."

msgid "jeluna_description"
msgstr ""
"לירח יש השפעה מוזרה על Jeluna: המדוזות המעופפות האלה משנות את הצורה שלהן "
"במהלך חודש."

msgid "jemuar_description"
msgstr ""
"האבנים היקרות על הגב שלו הן מהסוג שהיה במקום שבו נולד. לכן יש חוות גידול "
"ענקיות של Rockitten מעל עורקי יהלומים."

msgid "joulraton_description"
msgstr ""
"הפרווה הזיפית והחשמלית שלו מושכת זרעים, פרחים ונוצות, שבהם הוא משתמש לאוכל "
"או לבניית קן."

msgid "k9_description"
msgstr "הוא חבר עוזר שיכול למשוך משא של טון שלם."

msgid "katacoon_description"
msgstr ""
"בזמן שהוא בגולם, הוא נשאר בתנוחת מדיטציה, וזז רק כדי לתת דחיפה ליריבים."

msgid "katapill_description"
msgstr ""
"הוא נולד מוכן להתמודד: הוא חייב לתת אגרוף ולשבור את קליפת הביצה, אחרת יישאר "
"תקוע בפנים."

msgid "kernel_description"
msgstr ""
"Kernel הוא רכיב מרכזי במערכת המפלצות (המחסה) ובמערכת החפצים (הארונית), והוא "
"הממשק הראשי בין החומרה של המחשב לבין התהליכים שרצים עליו. היוצרים שלו קוראים"
" לו JAS-KERI-BIT."

msgid "knightsand_description"
msgstr ""
"Knightsand מסייר סביב ארמונות חול שבהם גרים Pawsand, אבל הוא גרוע מאוד "
"בבנייה שלהם."

msgid "knindling_description"
msgstr "כל ניצוץ מאבן, Knindling מטפח בשמחה עד שהוא הופך לאש."

msgid "komodraw_description"
msgstr "הוא משתמש בטפרים שלו כדי לגלף קלע מעץ, ומשתמש בו למתקפות חזקות מרחוק."

msgid "komoduel_description"
msgstr "הרבה עושי צרות ברחו מהעיר אחרי שראו רק את הצללית של Komoduel שמתקרב."

msgid "konuit_description"
msgstr ""
"במקומות מסוימים קוראים ל-Konuit \"דוב נופל\", ומאמינים שהוא קופץ מלמעלה על "
"ראשים של אנשים שלא שמים לב."

msgid "kroki_description"
msgstr ""
"Kroki מבלה את רוב הזמן במים רדודים, ומשתמש בלסתות החזקות שלו כדי לחטוף טרף."

msgid "krokivip_description"
msgstr ""
"התנין הרעיל הזה נהנה לארוב מתוך המים. ככל שהוא מתקרב להתפתחות, הוא מחפש "
"מקווי מים גדולים יותר."

msgid "lambert_description"
msgstr "ההורה שלו מכניס אותו לתוך אגוז, ואז שולח אותו לעולם."

msgid "lapinou_description"
msgstr ""
"כש-Squabbit הפכו לחיות מחמד אופנתיות, הם התרגלו לחיים בבית ואיבדו את הטבע "
"הפראי שלהם."

msgid "legko_description"
msgstr "הרבה זמן חשבו שאין לו רגליים, אבל העלים שלו הם בעצם שרידים של גפיים."

msgid "legoplaste_description"
msgstr ""
"יש לו צורה גמישה מאוד, והוא צד בעזרת זרועות דקות שהוא שולח לכל הכיוונים, כדי"
" לרחרח או לגעת בטרף שקרוב אליו."

msgid "lendos_description"
msgstr "כששני Uneye מסתבכים זה בזה, הם יוצרים Lendos אחד ומאוחד."

msgid "lesmagu_description"
msgstr ""
"הוא זוחל לאט על קרקעית הים ומחפש פינות וחריצים קשים להתחבא בהם, עד שיגדל לו "
"שריון."

msgid "lettice_description"
msgstr "מזג אוויר קר מרכז את הכוח והחיוניות של Lettice."

msgid "leviadile_description"
msgstr ""
"בזכות הגודל העצום והלסתות הרעילות והחזקות שלו, Leviadile הוא הטורף השולט "
"במעמקי הים."

msgid "lightmare_description"
msgstr ""
"הוא אורב במעמקי האוקיינוס, ומפתה טרף תמים בעזרת האור שלו, היישר לתוך הפה "
"הגדול והפעור שלו."

msgid "loliferno_description"
msgstr ""
"אומרים שאי אפשר לכבות את האש של Loliferno. ובכל זאת, למרות הכוח שלו, יש "
"ל-Loliferno צד שובב, והוא ידוע בכך שהוא רוקד בין הלהבות שהוא יוצר."

msgid "lucifice_description"
msgstr ""
"האם זו הרוח שמייללת בין העצים, או Lucifice שקורא לרוחות הלילה להצטרף לציד "
"שלו?"

msgid "lunight_description"
msgstr ""
"Lunight הוא שומר הלילה, והוא יכול לשלוט בירח ובשלבים שלו, מירח מלא ועד ירח "
"חדש."

msgid "magmaturtle_description"
msgstr ""
"כשמאיימים עליו, הוא נסוג לתוך השריון שלו ומתקרר מהר מאוד בעזרת שחרור אדים. "
"אפשר לחשוב בטעות שהוא סלע."

msgid "manosting_description"
msgstr "הוא מרחף מעל הגגות של ערים, ומהרהר בכרישים."

msgid "marvantis_description"
msgstr ""
"כשהוא מתפתח, הסימן היחיד שנשאר מההסוואה המקורית שלו הוא הקישוטים האדומים."

msgid "marvillar_description"
msgstr ""
"Marvillar מחקה זחל של נמלה בעזרת ריח. הוא משכנע את Scarlant ו-Myrmison "
"להאכיל אותו, ואת מי שחושד בו הוא אוכל."

msgid "masknake_description"
msgstr "כשהוא מפוחד או כועס, הוא מציג דוגמה יפה בעזרת הזנב שלו."

msgid "mauai_description"
msgstr ""
"Mauai נותן לרוחות של לוחמים עתיקים, שכלואות בתוך הנשק שלו, להוביל אותו."

msgid "medipup_description"
msgstr ""
"כש-Medipup מרחרחים מחלה, הם קופצים אל היצור החולה ומתחככים בו באף. האף הרטוב"
" של Medipup באמת עוזר, אבל כמה חולים כבר קיבלו יותר מדי חיבוקים מלהקה נלהבת "
"מדי."

msgid "medushock_description"
msgstr ""
"הם נוטים להתרחק מהחוף, וידוע שהם עלולים לתקוף אנשים. הם משתמשים בעוקצים כדי "
"לשתק את הטרף. שחו בזהירות!"

msgid "megafruitera_description"
msgstr ""
"יש לו קצת יותר שליטה עצמית מאשר בצורה הצעירה שלו: אם הוא צריך מקום לעוד "
"פירות, הוא קודם מגדיל את הקן."

msgid "memnomnom_description"
msgstr "אומרים שהמסכה של כל אחד מהם היא הפנים של מלך עתיק אחר."

msgid "merlicun_description"
msgstr ""
"Merlicun הוא חרק עמיד שהתפתח כך שהוא טוב גם בהתקפה וגם בהגנה. הם מתאספים "
"בצמרות העצים של יערות עתיקים כדי לאכול פירות ועלים."

msgid "metesaur_description"
msgstr ""
"הנגמון הזה נהנה לצלול לתוך האדמה ולהשאיר סימנים. לפעמים הוא טועה בחישוב "
"ונוחת בין העצים, וגורם לשריפות יער ענקיות ומסוכנות."

msgid "metoxic_description"
msgstr ""
"Metoxic משמש לפעמים כדגל לארמונות של Pawsand, ופולט אדים רעילים לכל עבר."

msgid "miaownolith_description"
msgstr "הוא יודע לדבר בשפת בני האדם, אבל רק כדי לומר חידות מסתוריות."

msgid "mingdyn_description"
msgstr ""
"פעם ב-12 שנים, מוטלת ביצה אחת של Mingdyn. כשמוצאים אותה, זה סימן לתקופה של "
"התחדשות ושל שינויים גדולים בכל הארץ."

msgid "moloch_description"
msgstr "הוא יכול להקשיח או לרכך את העור שלו, לפי אם הוא פוגש חברים או יריבים."

msgid "mrmoswitch_description"
msgstr ""
"הרובוטים החצופים האלה משמשים לעבודות עדינות ומדויקות, אבל הכי הם אוהבים "
"מתיחות."

msgid "myrmison_description"
msgstr ""
"מלכות Myrmison יוצאות בימים לחים כדי לנסות להקים מושבות חדשות. זו תקופה "
"מסוכנת מאוד בשבילן."

msgid "mystikapi_description"
msgstr ""
"הרוק של Mystikapi מחזק כוחות על-חושיים. הוא מלקק את העיניים והאוזניים שלו "
"כדי לחדד את החושים."

msgid "narcileaf_description"
msgstr ""
"כש-Shybulb מחזיר גינה לתפארתה, הוא משתנה ולוקח בגאווה את הקרדיט על העבודה."

msgid "nebufin_description"
msgstr "המראה המלאכי של Nebufin מטעה, כי המפלצת הזאת היא בעצם טורפת."

msgid "ned_description"
msgstr "ל-Ned יש יריבות עם Konuit, אבל Konuit ישן ברוב הוויכוחים שלהם."

msgid "neutrito_description"
msgstr "Neutrito לא מרגיש כלום. המכונה המושלמת?"

msgid "nimbulex_description"
msgstr "Nimbulex מתלבש בניצוצות ובענני סערה כדי להגן על הליבה העדינה שבתוכו."

msgid "ninjasmine_description"
msgstr "Ninjasmine מרעיל את היריבים שלו במהירות בעזרת שתי חרבות הרעל שלו."

msgid "noctalo_description"
msgstr "הוא גר רק במקומות שבני אדם נטשו: טירות, חורבות וביוב."

msgid "noctula_description"
msgstr ""
"הוא אוכל פירות, ו-Pipis אוכלים חרקים, אז למרות שהם גרים קרוב זה לזה, הם לא "
"מתחרים."

msgid "nostray_description"
msgstr "הוא יכול להריח כל דבר באוקיינוס, לא משנה כמה רחוק."

msgid "novaquarius_description"
msgstr ""
"עקיצה של Novaquarius שולחת את מי שלא נזהר לבית החולים, אבל Bubbitoise פיתחו "
"חסינות, והם אפילו מכרסמים אותם."

msgid "nudiflot_female_description"
msgstr "הוא אוכל ושומר בגוף את הרעל של יצורי הים שהוא ניזון מהם."

msgid "nudiflot_male_description"
msgstr "המחושים דמויי הנוצות שלו נשברים אם תוקפים אותו, וזה מבלבל את הטורף."

msgid "nudikill_description"
msgstr "קוראים להם \"הכובענים האפלים\", כי הראש שלהם מזכיר כובע גבוה ומחודד."

msgid "nudimind_description"
msgstr "הוא חולם על אוקיינוסים מתחת לשמיים אחרים."

msgid "nuenflu_description"
msgstr "בחודשי החורף הוא מתכרבל בבתים ומפיץ שפעת. כדאי לשטוף ידיים!"

msgid "nut_description"
msgstr ""
"בספינות הגדולות שחוצות את האוקיינוסים, אלפי Nut ו-Bolt מספקים כוח ומחזיקים "
"את לוחות הפלדה יחד."

msgid "octabode_description"
msgstr ""
"Octabode הופכים כלים וחפצים עתיקים לבית שלהם, וחולמים על החיים של מי שהשתמשו"
" בהם לפניהם."

msgid "ouroboutlet_description"
msgstr "המעגל מרכז אנרגיה ויוצר סוג חדש של חשמל, שנקרא \"ברק עצוב\"."

msgid "pairagrim_description"
msgstr "אחד הראשים של Pairagrim תמיד מחפש טרף, והשני מתרכז בלעוף מהר מאוד."

msgid "pairagrin_description"
msgstr ""
"הצורה הצעירה של Pairagrim. בדרך כלל הוא יצור שמח. קשה לו לעוף עד ששני הראשים"
" לומדים לעבוד יחד."

msgid "pantherafira_description"
msgstr ""
"כל חבר בלהקה מדליק את הרעמה שלו ממדורה משותפת. כל עוד האש בוערת, הם חולקים "
"את הכוח שלהם."

msgid "parappi_description"
msgstr ""
"כשחותכים את Parappi, יוצא ממנו סירופ שמכסה את היריבים ומתקשה, ומקפיא אותם "
"במקום כמו ענבר."

msgid "pawsand_description"
msgstr ""
"Pawsand גר בארמונות חול ובמקדשי חול שבנו Bishosand ו-Rooksand. חלק מהם הם "
"בעצם Rooksand עצמו."

msgid "pearamanca_description"
msgstr ""
"Pearamanca מוכר ביטוח לאנשים תמימים שרק רוצים לקנות פירות, ולכן הוא המפלצת "
"הכי מפחידה מכולן."

msgid "pharavion_description"
msgstr ""
"אחרי מאמץ גדול, מאמן יכול לגרום לגור Pharfan המגושם להתפתח לצורה הבוגרת, "
"שמרחפת בחן למרות הגודל העצום שלה."

msgid "pharfan_description"
msgstr ""
"ליד בור המים, הוא דואג שלחברים שלו, Rinocereed ו-Hampotamos, יהיו מספיק מים."

msgid "picc_description"
msgstr "הוא מלווה צוללנים ומספק להם חמצן שהם מאוד צריכים."

msgid "pickoon_description"
msgstr "הוא נהנה להרים דברים ולתחוב אותם בשקט לתוך הצעיף שלו."

msgid "pigabyte_description"
msgstr "מדענים גילו שהמחשבים הכי טובים הם אלה שיש בהם חלקים חיים."

msgid "pilthropus_description"
msgstr ""
"Pilthropus, שחי לצד נגמונים כמו Rhincus, היה אחד הנגמונים הראשונים שידעו "
"להכין כלים בעצמם."

msgid "pipis_description"
msgstr "הקריאות שלו נחשבות לסימן רע, אבל הוא יצור עדין."

msgid "poinchin_description"
msgstr "Poinchin בונים קנים באלמוגים, ואפשר לפתות אותם לצאת בעזרת לחם וחלב."

msgid "polyrock_description"
msgstr ""
"הוא מתחפש לילד אנושי כדי להתגנב לדוג'ואים וללמוד ממורים לאומנויות לחימה."

msgid "possessun_description"
msgstr "הוא רוח רפאים שגרה בתוך Cairfrey ישן ושבור."

msgid "potturmeist_description"
msgstr ""
"Potturmeist הם יצורי רוח עתיקים שמוצאים מחסה בכלים ריקים. במקדשים עתיקים, "
"העוזרים צריכים להסיח את דעתם, כדי שלא יפריעו לטקסים חשובים."

msgid "potturney_description"
msgstr ""
"עד ש-Potturmeist מגיע לבגרות, הכד שמגן עליו משנה צורה כל כך, שהוא כבר לא "
"דומה לשום כלי חרס שבני אדם עשו. יש שמתעקשים שהציורים על הכד של Potturmeist "
"הם כתבים מהעתיד הרחוק."

msgid "primordia_description"
msgstr "אומרים שהוא האב הקדמון של כל הנגמונים."

msgid "propellercat_description"
msgstr "האם זה זן חדש, או סתם חיית המחמד של ממציא?"

msgid "prophetoise_description"
msgstr "האש השמימית שלו היא משהו שיריבים כמעט אף פעם לא רואים מגיע."

msgid "puparmor_description"
msgstr ""
"הגולם שלו כל כך קשה, שאם Puparmor נופל על מישהו, נשארת לו בליטה בראש לכמה "
"ימים. פעם אפילו טענו אותם בתותחים ובמכונות שיגור."

msgid "pyraminx_description"
msgstr "יש לו מקום מנוחה סודי אי שם בארץ. אם ימצא אותו, יוכל לישון."

msgid "pythock_description"
msgstr ""
"בעזרת בובות הצל שלו, הוא יכול להתמודד מול היריב בדיוק ובמהירות רבים. הם "
"בטוחים בעצמם הרבה יותר, ולפעמים אפילו משתמשים בבובות הצל כדי לשעשע ילדים "
"קטנים בהצגות בובות."

msgid "pythonova_description"
msgstr ""
"הוא חם מזג, וכשהוא כועס מאוד, הלהבות על הגב שלו בוערות חזק יותר, וזנב העשן "
"שלו נעשה עבה וארוך יותר. הוא משתמש בזנב העשן כדי להתפתל סביב היריב ולעטוף "
"אותו."

msgid "pythwire_description"
msgstr "תצפיות על Pythwire פראיים נתנו השראה לממציא של שקע החשמל הראשון."

msgid "qetzlrokilus_description"
msgstr ""
"הנגמון הזה נהג לצלול לתוך קבוצות של נגמוני דינוזאור אחרים ולחמם אותם באש "
"שלו. הוא גם נהנה להצית יערות ולפזר את האפר במים, וכך ללכלך אותם."

msgid "rabbitosaur_description"
msgstr "המנהרות שלו ארוכות ורחבות, ושם מתנהלות מריבות ענק בין מחילות שכנות."

msgid "raccscal_description"
msgstr ""
"יש לו על הגב זנב דמוי שק, שהוא יכול לפתוח ולסגור, ואפילו לנתק ולזרוק על "
"יריבים."

msgid "raptoucan_description"
msgstr "הוא מרשים ותוקפני, אבל אוכל רק פירות."

msgid "regalance_description"
msgstr "הוא יכול לזמן רומח מתי שהוא צריך."

msgid "rhincus_description"
msgstr "יש לו כמה תכונות של זוחל וכמה של ציפור."

msgid "rhinocarpe_description"
msgstr ""
"Rhinocarpe שומרים על השטח שלהם, ומסתערים עם הראש קדימה על כל מי ששוחה קרוב "
"מדי למבצרי האלמוגים שלהם."

msgid "rinocereed_description"
msgstr "הוא רעב מאוד כי הוא גדל כל כך מהר, והוא לא מסתפק רק בצמחים."

msgid "rockat_description"
msgstr "למרות המשקל הכבד שלו, הצעדים שלו שקטים לגמרי."

msgid "rockitten_description"
msgstr "הוא משתמש באוזני הסלע הקטנטנות שלו כדי להתכרבל."

msgid "rooksand_description"
msgstr ""
"Rooksand מרשה לפעמים למי שראוי בעיניו לגור בתוך ארמון החול שלו, ואת כל השאר "
"הוא מגרש."

msgid "rosarin_description"
msgstr "החום והאהבה של Rosarin מדהימים, והוא רק מבקש קצת חיבה בחזרה."

msgid "ruffalo_description"
msgstr ""
"ל-Ruffalo יש כוח עצום, והוא יכול להסתער במהירות גבוהה ולהפיל עצים ובניינים "
"קטנים."

msgid "runesquito_description"
msgstr ""
"הסימן האדום הבוהק הוא Runesquito עצמו. כל השאר הוא רק שריון סלעי שהוא רוכב "
"עליו."

msgid "ruption_description"
msgstr ""
"כשהלהבה של Embra נעשית חמה מספיק, היא עוטפת את כל הגוף שלו, ולמעשה מחליפה "
"אותו."

msgid "sadito_description"
msgstr "כשמישהו עצוב מדי, Sadito נושא בשבילו את הנטל."

msgid "sampsack_description"
msgstr "מדען רצה להפריד בין האישיויות שלו, אבל במקום זה הגוף שלו התפצל."

msgid "sampsage_description"
msgstr "מדען שתה שיקוי שהפך אותו לחכם ביום ולפראי ועצבני בלילה."

msgid "sapragon_description"
msgstr ""
"בימים עברו, לכל יסוד היה דרקון אדיר. אבל היצורים האלה הלכו ונעלמו, והיום הם "
"נדירים."

msgid "sapsnap_description"
msgstr "הכעס העצום שלו מרתיע, אבל הוא חולף מהר."

msgid "saurchin_description"
msgstr ""
"בלילה, Saurchin יוצאים משוניות האלמוגים כדי לצוד טרף גדול יותר על היבשה."

msgid "scarlant_description"
msgstr "היריב הכי גדול שלו הוא Marvillar, שמעמיד פנים שהוא בן משפחה."

msgid "sclairus_description"
msgstr ""
"כשיבול נשאר בשדה ואף אחד לא קוטף אותו, בגלל עצלות או אסון, הדחליל שלו הופך "
"ליצור חי ואפל."

msgid "seirein_description"
msgstr ""
"בביצות הוא מרגיש בודד, ולכן הוא זוהר חזק כדי למשוך אליו מטיילים. אבל הוא "
"ביישן נורא, ומתעופף משם כשהם מתקרבים."

msgid "selket_description"
msgstr "הם אורבים מתחת לחול, ומרגישים את הטרף לפי הרעידות של הצעדים שלו."

msgid "selmatek_description"
msgstr ""
"מלכי המדבר העתיקים החזיקו את Selmatek ככלבי שמירה וכשותפים לציד, ועכשיו הם "
"שומרים מפני שודדי אוצרות."

msgid "seraphice_description"
msgstr ""
"Seraphice יכול להקפיא בתוך קרח רגעים של אומץ ושמחה גדולים, ולשמור אותם "
"בכספות עמוקות מתחת להרים, לימים שבהם האנושות תצטרך אותם יותר מכול."

msgid "shammer_description"
msgstr "בימי קדם הוא צד את Rhincus תחת שמיים אפורים מאפר."

msgid "sharpfin_description"
msgstr ""
"הוא בלתי נראה במים, ואפשר לראות אותו רק כשהוא קופץ החוצה כדי לחטוף חיות "
"מהחוף אל המעמקים."

msgid "shelagu_description"
msgstr ""
"הוא מרחיק תוקפים בכך שהוא מורח על השריון הקוצני שלו נוזל רעיל שהוא יורק "
"מהפה."

msgid "sheye_description"
msgstr ""
"Sheye כבדים ממחשבות כבדות. מאמנים שאוהבים סגנון אפל אוהבים אותם בגלל המראה "
"המסתורי וההבעה הרצינית."

msgid "shimmerain_description"
msgstr "אומרים שכשקשת מופיעה מעל המים, Shimmerain מטילים ביצים."

msgid "shnark_description"
msgstr "Shnark מתחפש ליצור אחר כדי להתקרב לטרף תמים שסומך עליו."

msgid "shrab_description"
msgstr ""
"כש-Sheye משחרר את המחשבות שלו מכל הדברים הרציניים, הוא הופך ל-Shrab, חופשי "
"לנדוד בעולם."

msgid "shybulb_description"
msgstr "כשמזניחים גינה, Shybulb עובר לגור בה ומטפל בשקט בצמחים הנבולים."

msgid "shull_description"
msgstr ""
"Shull לא צריך לאכול או לזוז, אבל הוא בכל זאת נהנה מפינוקים ותוספים מהאדם "
"האהוב עליו, במיוחד אם שולחים אותו לדו-קרבות לעיתים קרובות."

msgid "skwib_description"
msgstr ""
"Skwib צף בנחת באוקיינוס ובודק קונכיות שיכולות להיות בית. רק כשהוא ממש מפחד, "
"הוא סוף סוף מחליט."

msgid "slichen_description"
msgstr "זה ג'ל שקיבל ניצוץ חיים, ומתחיל לבנות לעצמו גוף מאבן ומסלע."

msgid "sludgehog_description"
msgstr ""
"הוא חי בזבל, וגם אוכל אותו. הקוצים שלו נראים חדים, אבל הוא יכול לרכך אותם "
"מתי שהוא רוצה."

msgid "snaki_description"
msgstr ""
"Snaki הוא נחש שלמד לגדל רגליים בזכות התבוננות בתנועה של לטאות ותנינים."

msgid "snarlon_description"
msgstr "הוא לא עף, אבל הרגליים שלו אף פעם לא נוגעות באדמה. מלך הפרדוקסים."

msgid "snock_description"
msgstr ""
"היצור דמוי הנחש מסתתר בביטחון מתחת לכיסוי הגרב שלו. אם הוא נבהל, הוא מתפתל "
"ואז שוכב בלי לזוז על הקרקע, כדי שלא ישימו לב אליו."

msgid "snokari_description"
msgstr ""
"לכל אחד משני הראשים של Snokari יש חוכמה גדולה, אבל הם אף פעם לא מסכימים."

msgid "snowrilla_description"
msgstr "הוא נהנה לשחק תופסת עם גולשי סקי במדרונות נטושים."

msgid "sockeserp_description"
msgstr "בדרך כלל הוא יריב מרשים, אבל קל לנצח את Sockeserp אם הוא מסתבך בעצמו."

msgid "solight_description"
msgstr ""
"צוות של נבלים זומם להשתמש ב-Solight כדי ליצור שמש קטנה, ובעזרתה כוכב לכת "
"חדש."

msgid "spectera_description"
msgstr ""
"העטלף הזה, שיש לו כנפיים דמויות עלים, אוכל הכול, אבל מעדיף פירות. גם הזכר "
"וגם הנקבה מטפלים בצאצאים."

msgid "sphake_description"
msgstr ""
"Sphake גורם לפעמים לרעידות אדמה קטנות שמפילות ספרים וכוסות מהמדפים, ואז הוא "
"אוכל כל מה שנופל."

msgid "spighter_description"
msgstr ""
"זה לא הוגן שמישהו שכל כך טוב בלהתגנב אל אחרים, לא נותן לאף אחד להתגנב אליו."

msgid "spirain_description"
msgstr ""
"אם האש הפנימית של Seirein נחלשת, טבע רוח המים שלו הופך אותו ל-Spirain."

msgid "spoilurm_description"
msgstr "Spoilurm מתחפשים לתפוחים ומחכים על העצים כדי להפתיע את מי שלא חושד."

msgid "sprightly_description"
msgstr "צמח ביישן. הוא מציץ עם הראש מעל האדמה כדי לשתות מים ושמש. "

msgid "sprorm_description"
msgstr "Cardinale אוכל את Sprorm, ויכול להמיס אותו."

msgid "spycozeus_description"
msgstr "הלחישות של היער מקבלות צורה ממשית ב-Spycozeus, שחושב כמו העצים."

msgid "squabbit_description"
msgstr "כדי להוכיח את עצמם, הם יתמודדו בכל הכוח אפילו על הדבר הכי קטן."

msgid "squink_description"
msgstr "הוא נקרא על שם הקול \"סקווינק\" שהוא משמיע כשנגמר לו הדיו."

msgid "statursus_description"
msgstr ""
"Statursus למד לתעל את הרגשות שלו ללהבה טהורה אחת. מספיק להסתכל עליה, ואחרים "
"נכנסים לטראנס."

msgid "stegofor_description"
msgstr ""
"כשמגיע הזמן להשתנות, Stegofor נודדים בעדרים גדולים בדרכים עתיקות, ואוכלים כל"
" צמח שגדל לאורך הדרך."

msgid "stomic_description"
msgstr ""
"Stomic רדיואקטיבי, אבל חיידקים שעמידים לקרינה, כמו Glomon, עדיין מסוכנים "
"בשבילו."

msgid "stonifly_description"
msgstr ""
"השלד החיצוני של Stonifly חזק וקשה כמו סלע, והוא שריון טבעי. הכנפיים השקופות "
"שלו מאפשרות לו לעוף מהר."

msgid "strella_description"
msgstr "הזנבות שלו הם פיתיונות, שגורמים לחרקים לנשוך אותם ולהילכד."

msgid "sumchon_description"
msgstr ""
"הוא משתמש במשקל שלו כדי להפיל יריבים גדולים ממנו בהרבה. הוא דחוס כמו כוכב."

msgid "sumobug_description"
msgstr ""
"הוא משתמש במשקל שלו כדי להפיל יריבים גדולים ממנו בהרבה. הוא דחוס כמו כוכב."

msgid "tadcool_description"
msgstr "הוא מקרקר כדי להזהיר אנשים כשהם הולכים ליד קרח דק."

msgid "tarpeur_description"
msgstr ""
"הם נחים וגדלים. הם גם גדלים ונחים. לעיתים רחוקות, הם נחים בלי לגדול, או "
"גדלים בלי לנוח."

msgid "taupypus_description"
msgstr ""
"כש-Taupypus נולד, אמא שלו מכסה את העיניים שלו בשכבת הגנה. כך העיניים שלו אף "
"פעם לא צורבות כשהוא צולל למים."

msgid "teddisun_description"
msgstr "Teddisun מעריץ את השמש. תמיד רואים אותו מחזיק את צעצוע השמש שלו."

msgid "tetrchimp_description"
msgstr ""
"הם סופגים כל מידע שהם נתקלים בו. הפטפוט הבלתי פוסק שלהם מספר את כל מה שלמדו,"
" לפי הסדר."

msgid "thumpurn_description"
msgstr "הם חובטים ביריבים שלהם באגרופים, ורוקעים באדמה כדי להזהיר."

msgid "tigrock_description"
msgstr "אומרים שהוא נאלץ להמציא את עצמו, כי אף אחד לא תכנן לו התפתחות."

msgid "tikoal_description"
msgstr "השומר של שבט שגר ביער. הוא שומר עליהם ופותר מריבות."

msgid "tikorch_description"
msgstr "הוא המתווך בין היער להר הגעש, בין השמש לאדמה."

msgid "tobishimi_description"
msgstr ""
"Tobishimi מטילים המון ביצים, ונושאים אותן מתחת לסנטר כדי לשמור עליהן עד הירח"
" המלא הבא, ואז הן בוקעות."

msgid "tornicane_description"
msgstr ""
"Tornicane רותם את הכוח של טורנדו ושל הוריקן גם יחד. הוא כוח טבע חי, והוא "
"יכול להיות הצלה או אסון למי שמקווה לגשם."

msgid "toucanary_description"
msgstr "ל-Toucanary יש נוצות בוהקות רק כי הוא גדל מוקף בפרחים."

msgid "toufigel_description"
msgstr "הוא נראה כמו חרק פרוותי, אבל בעצם הוא זוחל שמכוסה בשלג רך."

msgid "tourbidi_description"
msgstr "מעגל של פטריות או תלתנים הוא מקום שבו Tourbidi רוקדים."

msgid "toxiris_description"
msgstr "Toxiris חזק מאוד, והוא מרעיל בעוצמה כל מה שעומד בדרכו."

msgid "trapsnap_description"
msgstr "הראש שלו הוא החלק היחיד בגוף שלא גדל כשהוא מתבגר."

msgid "trojerror_description"
msgstr ""
"Trojerror הוא נגמון שמתחפש לקוד או לתוכנה אמיתיים. ברגע שהם נכנסים לרשת, "
"Trojerror יכולים לעשות כל פעולה שמשתמש אמיתי יכול לעשות (להפקיד, למשוך "
"ולמחוק)."

msgid "tsushimi_description"
msgstr ""
"אמנם לפעמים קוראים להם שריון, אבל הלוחות הבשרניים על Tsushimi רכים יותר "
"מהעור שלו. אף אחד עוד לא יודע למה הם משמשים."

msgid "tumblebee_description"
msgstr ""
"הוא בונה כוורות שהן כדורים מושלמים, ו-Tumblebee שבפנים פשוט מתגלגל ומזמזם "
"מצחוק."

msgid "tumbledillo_description"
msgstr ""
"ל-Tumbledillo יש קשר מיסטי לכביש מסוים, והם שומרים עליו מפני אנשים שרוצים "
"להתערב בו. אפילו מפני צוותים שמתקנים בורות בכביש!"

msgid "tumblequill_description"
msgstr ""
"Tumblequill מתגלגל לאורך הכבישים, ואוסף חפצים שימושיים לקן שלו מתוך הזבל "
"שאנשים משאירים בצד הדרך."

msgid "tumbleworm_description"
msgstr ""
"כשהם גדלים מדי בשביל ביצי חלת הדבש שלהם, הם נופלים לקרקע עם הפנים קדימה."

msgid "turnipper_description"
msgstr ""
"כששדה ננטש ונשאר לעורבים, לארבה ולעכברים, לפעמים Turnipper חופר את עצמו "
"החוצה מהאדמה כדי להגן על היבול."

msgid "tux_description"
msgstr ""
"Tux מרגישים הכי נוח באקלים קוטבי. הם צדים טרף חלש מהם בקפיצה עליו, ופותחים "
"קונכיות או שריון של טרף חזק יותר בכך שהם מחליקים אותו על הקרח אל סלעים קשים."

msgid "tweesher_description"
msgstr ""
"ככל שמזג האוויר קר יותר, המקור שלו קשה יותר. מתחת ל-0 מעלות, הוא קשה יותר "
"מיהלום."

msgid "uf0_description"
msgstr ""
"נראה שהיצור המוזר הזה נמשך לצלילים גבוהים מדי בשביל שאוזניים אנושיות ישמעו "
"אותם."

msgid "uglip_description"
msgstr "כשמושכים אותו מהר מדי מהבית שלו במים העמוקים, Uglip מתנפח וכואב לו."

msgid "uneye_description"
msgstr "Uneye אורב בצללים, ובקצה שדה הראייה."

msgid "uprout_description"
msgstr ""
"כשהוא גדל, האוזניים שלו נפתחות ומגלות כנפיים, שבעזרתן הוא עף אל העצים שמעל "
"המקום שבו גדל. "

msgid "urcheedle_description"
msgstr ""
"הוא לא יכול לזוז או לתקוף, אז הוא יושב בשקט ומקווה שהיריב ייפגע מהמחטים "
"הרבות שלו."

msgid "urcine_description"
msgstr ""
"כש-Furnursus נולד בלי האש שבתוכו, הוא יוצא לחיות לבד ביער בתור Urcine."

msgid "vamporm_description"
msgstr "הוא חולם על משקה אדום וסמיך, אבל נאלץ להסתפק במוהל של עצים."

msgid "velocitile_description"
msgstr "הוא יכול לרוץ מהר יותר מטיל, אבל רק אחרי שהוא מתחמם."

msgid "vigueur_description"
msgstr ""
"Vigueur מתחרים מי ירים את הסלע הכי כבד. כשהם מרימים סלע כבד מדי, הם נופלים "
"מתחתיו ומפזרים זרעים של Tarpeur."

msgid "virware_description"
msgstr ""
"Virware בדרך כלל רדום, עד שמישהו מפעיל אותו: מוריד אפליקציה פגומה או לוחץ על"
" קישור נגוע. אחרי שהוא מופעל, Virware יכול לבצע כל מיני משימות."

msgid "vivicinder_description"
msgstr ""
"הוא בונה את הקן שלו באש שבוערת זמן רב, שהוא הדליק בעצמו, או באש של אנדרטאות,"
" נפחיות ובתי מלאכה לזכוכית."

msgid "vividactil_description"
msgstr "בימי קדם, שנת ה-Vividactil סימנה תקופה של התחדשות ושל החזרת הסדר."

msgid "vivipere_description"
msgstr "הוא בוקע בכמויות גדולות בקיץ, אבל שאר החיים שלו הם תעלומה."

msgid "viviphyta_description"
msgstr "הוא מלך הנחשים. או לפחות הוא בטוח שהוא כזה."

msgid "vivisource_description"
msgstr "למעיין שהוא בוחר לגור בו יש תמיד טעם מוזר של בצל."

msgid "viviteel_description"
msgstr "הוא לוקח שריון ישן של לוחם עתיק, ומשתמש בו כקונכייה."

msgid "vivitrans_description"
msgstr "הקור מחדד את המחשבות של Vivitrans כמו להב."

msgid "vivitron_description"
msgstr ""
"פילוסופים קדומים השתמשו ב-Vivitron כהוכחה לכך שאפשר לאלף את כוחות הטבע "
"ולשלוט בהם."

msgid "volcoli_description"
msgstr "הוא הרוח של יער. השיער שלו משתנה עם עונות השנה."

msgid "volconey_description"
msgstr ""
"כש-Volconey רוקעים באדמה ברגליים הענקיות שלהם, הם קוראים לעוד ועוד Thumpurn "
"ו-Volconey למאורה. אבל כשמספיק מהם רוקעים בבת אחת, אומרים שזה גורם "
"להתפרצויות געשיות."

msgid "vulpyre_description"
msgstr ""
"איך הוא מתפתח ואיך הוא חי, זו תעלומה גדולה. אבל לפעמים רואים אותו ליד הר "
"געש."

msgid "waysprite_description"
msgstr "אומרים ש-Waysprite נוצרים כשאדם עומד בפני החלטה קשה."

msgid "weavifly_description"
msgstr "כשהוא כבד מביצים, הוא לא מסוגל לעוף."

msgid "weedlantis_description"
msgstr ""
"אומרים שפעם ציוויליזציה עתיקה השתמשה ב-Weedlantis כיועצים, אבל מאז היא שקעה "
"ונעלמה מתחת לים."

msgid "weedsea_description"
msgstr "פעם בשנה, נגמונים ימיים כמו Shrab מאביקים אותו מתחת לגלים."

msgid "wendigger_description"
msgstr "אומרים ש-Wendigger צומח מהאדמה של מקומות עתיקים ונשכחים."

msgid "windeye_description"
msgstr ""
"כמו עץ אדיר, Windeye שותל את עצמו על ראש הגבעות כדי לספוג שמש ורוח. אחרי "
"שהוא נטען, הוא יוצא למצוא מקום אחר מתחת לשמיים."

msgid "wolffsky_description"
msgstr "הנגמון הזה מאוד ידידותי. נהוג לצאת למסעות בטבע בעזרת Wolffsky."

msgid "wolololl_description"
msgstr "הקוצים החדים של Wolololl מכוסים ברעל מסוכן מאוד."

msgid "woodoor_description"
msgstr ""
"כשבית רדוף רוחות נשרף עד היסוד, לפעמים כל מה שנשאר ממנו הוא דלת הכניסה. היא "
"קופצת משם כדי למצוא בית חדש."

msgid "wrougon_description"
msgstr "כל Wrougon נולד עם כתם חלודה גדול יותר מזה של ההורים שלו."

msgid "yiinaang_description"
msgstr "הוא נולד בפעם הראשונה שכוכב נפל לתוך חור שחור."

msgid "yamada_description"
msgstr ""
"רוחות ידועות כשובבות, אבל Yamada לוקחים את החוק ברצינות, ואפילו חושבים "
"שהתנהגות טובה חשובה יותר מכוח פיזי."

msgid "ziggurat_description"
msgstr ""
"שום מבוך לא יכול לעצור את Ziggurat. הוא מקשט את הקנים שלו בחריטות של כל "
"המבוכים שעבר במשך השנים."

msgid "zunna_description"
msgstr "Zunna העליז שואב לתוך הבטן שלו את כל האוכל שהוא מוצא."

msgid "water_intro1"
msgstr "חצית עכשיו את המדבר, וסוף סוף הגעת לאזור המים."

msgid "water_intro2"
msgstr "נגמון אגדי נראה כאן בסביבה, והוא עושה בלגן בכל האי."

msgid "water_intro3"
msgstr ""
"יחד עם הנגמון האהוב עליך, Agnite, באת לעזור לאנשים ולפתור את הבעיות שלהם."

msgid "water_intro4"
msgstr "עכשיו מחכה לך האתגר הכי גדול עד כה."

msgid "water_traveller_1"
msgstr "אה, באת לטייל? ברוכים הבאים לאי שלנו."

msgid "water_traveller_2"
msgstr "אבל אולי זה לא הזמן הכי טוב לביקור. דברים מוזרים קורים פה."

msgid "water_oldman_1"
msgstr "הטירה הזאת מובילה לחלק מסוכן מאוד של האי."

msgid "water_oldman_2"
msgstr "לא להיכנס, אלא אם ממש יודעים מה עושים."

msgid "water_rock1"
msgstr "תקשיבו -> לבחור -> הזה -> הוא -> ממש -> ממש -> חכם ->"

msgid "water_niceguy1_1"
msgstr "ברוכים הבאים לכפר שלנו."

msgid "water_niceguy1_2"
msgstr "כדי להמשיך הלאה באי, צריך אישור מראש הכפר שלנו, כי המצב נעשה מסוכן."

msgid "water_niceguy2_1"
msgstr "לכל כפר באי שלנו יש קשר מיוחד למים."

msgid "water_niceguy2_2"
msgstr "למשל, הכפר שלנו נמצא ממש ליד האוקיינוס. יש מים מכל הצדדים."

msgid "water_nurse1"
msgstr "אני ארפא את הנגמונים שלך."

msgid "water_nurse2"
msgstr "כולם בריאים. שמרו על עצמכם בדרך."

msgid "water_nice_mayor1"
msgstr ""
"שלום וברוכים הבאים לכפר שלנו. אנחנו חיים בשלום עם הנגמונים שלנו, וצפים בעדינות על האוקיינוס. כן, כל הכפר צף.\n"
" לא, אנחנו לא יודעים למה.\n"
" יום אחד התעוררנו, והכול פשוט שט על המים. החלטנו לזרום עם זה."

msgid "water_nice_mayor2"
msgstr ""
"צריך את האישור שלי לפני שממשיכים הלאה באי. בזמן האחרון הכול נעשה בלתי צפוי.\n"
" בניינים מתנדנדים, הגאות והשפל מתנהגים מוזר, ולפעמים הדגים בוהים בנו יותר מדי זמן. מה הביא אותך לכאן?"

msgid "water_nice_mayor3"
msgstr ""
"אה, שמעת על הבעיות שלנו. דברים מוזרים קורים בצפון, ונגמון מסתורי נראה שם.\n"
" אומרים שהוא גולש על המים בלי לגעת בהם. זה מרשים, וגם קצת לא מנומס."

msgid "water_nice_mayor4"
msgstr ""
"נראה שלך ולנגמונים שלך יש הרבה כוח. אם תוכלו לעזור לנו למצוא את הנגמון המוזר ולשים סוף לצרות שלנו, נהיה אסירי תודה.\n"
" לכפר שלנו אין הרבה, אבל אנחנו יכולים להציע עידוד והמון ציפה על המים."

msgid "water_nice_mayor5"
msgstr ""
"ראש הכפר הנחמד: אוי, אוי, אוי. הבן שלי גנב לך את Agnite. אני כל כך מצטער. יש לו הרגל לקבל החלטות גרועות במהירות שיא.\n"
" אני מבטיח לך, זו לא התנהגות רגילה. טוב, לא לגמרי רגילה."

msgid "water_nice_mayor6"
msgstr ""
"הנה, קחו שניים מהנגמונים הכי חזקים שלי. הם הגנו על הכפר מפני סערות, מפלצות ים, ופעם אחת גם מפני שחף כועס במיוחד.\n"
" בבקשה, נצחו את הבן שלי בדו-קרב ותלמדו אותו לקח, לפני שהוא גונב עוד משהו."

msgid "water_nice_mayor7"
msgstr ""
"קיבלת את Propellercat ואת Bugnin. הם נראים מבולבלים, אבל מוכנים לעזור."

msgid "water_nice_mayor8"
msgstr ""
"אני כל כך מצטער שהבן שלי גנב את הנגמון שלך. הוא חושב שכוח זה משהו שחוטפים ובורחים איתו.\n"
" בבקשה, נצחו אותו בדו-קרב ועזרו לו להבין שככה לא מתנהגים, אפילו בכפר צף."

msgid "water_rude_dude1"
msgstr ""
"החוצפן: לא נראה לי שיש לך מושג באימון נגמונים. יאללה, איפה הנגמון הכי חזק שלך?\n"
" אני רוצה לראות איך נראה כוח אמיתי, כי לי עצמי בטוח אין בכלל."

msgid "water_rude_dude2"
msgstr ""
"החוצפן: וואו, איזה נגמון מגניב. לא מגיע לך משהו כל כך חזק. מקווה שלא אכפת לך שאני לוקח אותו.\n"
" בעצם, אני מקווה שכן אכפת לך. ככה זה יותר כיף."

msgid "water_rude_dude3"
msgstr ""
"החוצפן גנב לך את Agnite. הוא רץ משם כמו מישהו שאף פעם לא חשב על התוצאות של "
"מה שהוא עושה."

msgid "water_helper1"
msgstr "ראיתי עכשיו ילד קטן רץ לידי לכיוון קצה הכפר."

msgid "water_goth1"
msgstr "מה? ילד חצוף עם נגמון? סליחה, לא ראיתי אף אחד עובר כאן."

msgid "water_outskirts_niceguy1"
msgstr "כל כך שקט פה. אבל היה נחמד יותר אם לא היו נגמונים שמתחבאים בדשא."

msgid "water_outskirts_niceguy2"
msgstr "אני אוהב פרחים."

msgid "water_outskirts_dude1"
msgstr ""
"אוי לא, מצאת אותי. כלומר... חה חה. נכנסת ישר למלכודת שלי.\n"
" בעצם לא הכנתי שום מלכודת, אבל כשאני מעמיד פנים שכן, אני מרגיש יותר חכם."

msgid "water_outskirts_dude2"
msgstr ""
"תתכוננו להתמודד עם הכוח של ה... של Agnite שלך.\n"
" הוא אוהב אותי יותר ממך. כנראה. אולי. אני מקווה."

msgid "water_outskirts_dude3"
msgstr ""
"מה זה... Agnite הסתובב נגדי. למה שיעשה דבר כזה?\n"
" נתתי לו חטיף. נכון, זה היה סלע, אבל בכל זאת."

msgid "water_outskirts_dude4"
msgstr "קיבלת את Agnite בחזרה. הוא נראה מרוצה, וגם קצת נבוך בשביל שניכם."

msgid "water_outskirts_dude5"
msgstr ""
"גרר... לא משנה. יש לי נגמונים עוד יותר חזקים לנצח אותך איתם. הנה!\n"
" מצאתי אותם מאחורי עץ. אולי הם בכלל לא שלי."

msgid "water_outskirts_dude6"
msgstr ""
"ניצחת את הילד, והנגמון שלך חזר אליך.\n"
" הילד נראה מתוסכל, מבולבל, ואולי גם רעב."

msgid "water_outskirts_dude7"
msgstr ""
"עכשיו אפשר להמשיך הלאה באי.\n"
" הילד ממלמל משהו על \"בפעם הבאה\" ועל חטיפים, ומתרחק."

msgid "water_cooldude1"
msgstr "אני כל כך מגניב. בטח אני היחיד שטיפס אי פעם על ההר הזה לבד."

msgid "water_cooldude2"
msgstr "וואו. מה מביא אותך לכאן?"

msgid "water_hiding_guy1"
msgstr "שששש... אני מתחבא מאומניצ'אנל."

msgid "water_hiding_guy2"
msgstr "אני לא סומך עליהם."

msgid "water_disciple1"
msgstr ""
"כמעט הגעת לחצי הדרך לכפר הבא. מעבר לגשר הזה יש נקודת אמצע, ושם אפשר לנוח."

msgid "water_postboy"
msgstr "אממ... נראה לי שהלכתי לאיבוד. אני קרוב לעיר טאבה?"

msgid "water_omniblock1"
msgstr ""
"אומניצ'אנל הגבילה את הגישה לחלק הזה של האי, למען הביטחון שלכם.\n"
" האזור סווג כאזור סכנה בדרגה 3, לפי מסגרת הפחתת הסיכונים שלנו.\n"
" נא לא להיבהל. זה לא יעיל."

msgid "water_omniblock2"
msgstr ""
"יש לקבל אישור מראש הכפר כדי להמשיך.\n"
" כך נשמרת התאמה לנהלים האזוריים שלנו, ונמנעים \"אירועי אחריות\" לא צפויים."

msgid "water_omniblock3"
msgstr ""
"מדיניות אומניצ'אנל אוסרת לעבור, בגלל נגמון אגדי בסיכון גבוה שנמצא לפנים.\n"
" כניסה בלי אישור עלולה לגרום ל\"חוויית לקוח לא מיטבית\"."

msgid "water_omniblock4"
msgstr ""
"אני עובד עכשיו באומניצ'אנל. סינרגיה תפעולית, אתם יודעים.\n"
" אנחנו שואפים לספק פתרונות בטיחות רחבי היקף, בעזרת התערבות יזומה, ומדי פעם קצת צעקות."

msgid "water_omni1"
msgstr ""
"אומניצ'אנל קבעה את הכפר הזה כמרכז הפעילות האזורי שלנו.\n"
" הפריסה האסטרטגית הזאת משפרת את היכולת שלנו לספק תוצאות אבטחה מבוססות ערך, וגם נותנת לנו נוף יפה."

msgid "water_omni2"
msgstr ""
"אומניצ'אנל תאבטח את הנגמון האגדי ותספק תוצאות גבורה מיטביות לאזור הזה.\n"
" הדוחות הרבעוניים שלנו תלויים בזה."

msgid "water_omni3"
msgstr ""
"אומניצ'אנל זיהתה שלכפר הזה יש קשר רב-ערך עם משאבי המים.\n"
" ניצול הנכס הזה הוא המפתח לתוכנית הקיימות ארוכת הטווח שלנו. לפחות כך כתוב בעלון."

msgid "water_omni4"
msgstr ""
"הכפר הזה נמצא בין שני נהרות, וזה מאפשר ניהול יעיל של זרימת פסולת.\n"
" אנחנו פשוט שמים את החומרים שלנו בנהר, ונותנים לטבע לטפל בשאר.\n"
" זה מה שאנחנו קוראים לו \"סילוק כמעט-ירוק\"."

msgid "water_omni5"
msgstr ""
"אומניצ'אנל ממליצה לא לבקר בכפר השלג ובכפר הר הגעש שלפנים.\n"
" האזורים האלה עוברים כרגע \"כיול יציבות מחדש\". כלומר, בלגן."

msgid "water_omni6"
msgstr ""
"אומניצ'אנל תשלח בהמשך סוכני שטח מוסמכים כדי לייצב את הכפרים האלה.\n"
" נא לציית לכל ההוראות, כדי להבטיח חוויה אזורית חלקה. התנגדות יוצרת ניירת."

msgid "water_nice_river1"
msgstr "הכפר הזה היה שקט ושליו, עד שאומניצ'אנל עברה לגור פה."

msgid "water_guide1"
msgstr "בצפון יש כפר קפוא שנגמון כועס תוקף אותו."

msgid "water_guide2"
msgstr "במזרח יש כפר על הר געש, ושם הנגמון האגדי עושה בלגן."

msgid "water_guide3"
msgstr "אני מפחד מדי ללכת לאנשהו."

msgid "water_iceguy1_1"
msgstr "לכפר שלנו יש קשר מיוחד למים. הוא בנוי על אגם קפוא."

msgid "water_iceguy2_1"
msgstr "הצילו. נגמון מסוכן תוקף את הכפר שלנו."

msgid "water_iceguy2_2"
msgstr "אם רוצים לעזור, כדאי לדבר עם ראש הכפר שלנו."

msgid "water_mayor1"
msgstr ""
"מפלצת תוקפת את הכפר שלנו. תוכלו לעזור לנו?\n"
" הקרח נסדק, הבתים רועדים, ומישהו הפיל את המרק שלו.\n"
" זה בלגן אחד גדול."

msgid "water_mayor2"
msgstr ""
"דברו איתי שוב כשתרגישו מוכנים להתמודד איתה. היצור ממשיך להקיף את האגם, כאילו הוא שופט אותנו.\n"
" אני לא אוהב שמישהו עם טפרים שופט אותי."

msgid "water_mayor3"
msgstr ""
"הנה היא. המפלצת תוקפת. הצילו. היא משמיעה רעשים חזקים, ואני ממש לא מוכן לזה "
"רגשית."

msgid "water_mayor4"
msgstr ""
"וואו, העפת את הנגמון הזה עד לים. זה היה מרשים.\n"
" תושבי הכפר יכולים סוף סוף להפסיק לצרוח. בערך."

msgid "water_mayor5"
msgstr ""
"נראה לי שיש לך מספיק כוח לעצור את הנגמון האגדי בכפר הר הגעש.\n"
" כדאי ללכת לשם ולעזור לכולם. גם הם בטח בפאניקה."

msgid "water_conifrost1"
msgstr ""
"מורגשת נוכחות חזקה מאחור. הטמפרטורה יורדת בדיוק מספיק כדי לגרום לך לחשוב "
"מחדש על ההחלטות שלך בחיים."

msgid "water_conifrost2"
msgstr ""
"זה הנגמון שניצחת כשהוא תקף את הכפר.\n"
" עכשיו הוא נראה רגוע יותר, כאילו חשב הרבה על ההתנהגות שלו."

msgid "water_conifrost3"
msgstr ""
"Conifrost התרשם מהכוח שלך, והוא רוצה לעזור לך לעצור את הנגמון האגדי.\n"
" הוא מהנהן בצורה רצינית וקפואה מאוד."

msgid "water_conifrost4"
msgstr "Conifrost הצטרף לקבוצה שלך. הוא עומד בגאווה, כאילו מצטלם לציור דרמטי."

msgid "water_volcano_guy1"
msgstr "לכפר שלנו יש קשר מיוחד למים."

msgid "water_volcano_guy2"
msgstr ""
"אנחנו גרים על הר געש, שבו החום מרתיח את המים לאדים, והאדים הופכים לעננים."

msgid "water_volcano_guy3"
msgstr "אני מפחד מהנגמון האגדי שמתחבא במערה הקרובה."

msgid "water_volcano_guy4"
msgstr "אני חייב לברוח לאזור פונדנט. אני בטוח ששם לא קורה שום דבר דרמטי."

msgid "water_volcano_guy5"
msgstr "הוא מתחבא... הנגמון האגדי... באגם שמצפון לכאן. אני מפחד."

msgid "water_volcano_oldman1"
msgstr ""
"מוכנים להתמודד עם הנגמון האגדי? רוב האנשים מסתובבים וחוזרים בנקודה הזאת.\n"
" יש כאלה שמעמידים פנים ששכחו משהו בבית. אחרים פשוט מתעייפים ונרדמים."

msgid "water_volcano_oldman2"
msgstr ""
"כשתרגישו מוכנים לאתגר הכי קשה שלכם, היכנסו למים. הכניסה נמצאת שם למטה.\n"
" כן, מתחת למים. לא, אני לא יודע מי תכנן את זה."

msgid "water_volcano_oldman3"
msgstr ""
"נכון מאוד. להיכנס למים. אין צורך לעצור את הנשימה. משהו שם למטה דואג לזה בשבילכם.\n"
" כנראה קסם. או מדע. או שניהם."

msgid "water_hint1"
msgstr "זו המערה של הנגמון האגדי."

msgid "water_hint2"
msgstr ""
"איפשהו כאן מתחבא הנגמון האגדי. צריך לעצור אותו ולשים סוף להשתוללות שלו."

msgid "water_hint3"
msgstr "הליכה בתוך המים מרפאת את הנגמונים שלך."

msgid "water_hint4"
msgstr "ואין מה לדאוג לגבי נשימה מתחת למים. כוח מוזר מאפשר לנשום כאן."

msgid "water_hint5"
msgstr "ולא לשכוח: הליכה במים מרפאת את כל הנגמונים שלך."

msgid "water_unusual1"
msgstr ""
"שלום, אדם מוזר. אני מניח שבאת לפגוש את החבר שלי. קוראים לו \"הנגמון האגדי\".\n"
" אני קורא לו \"זה שכל הזמן מפיל דברים\". שמות זה עניין גמיש."

msgid "water_unusual2"
msgstr ""
"נראה לך מוזר שמישהו גר מתחת למים. אבל האם זה לא מוזר יותר שעשית את כל הדרך הזאת כדי לפגוש אותי?\n"
" האנשים שלמעלה תמיד ממהרים. כאן למטה, המים מחליטים כמה מהר הולכים. בדרך כלל לאט."

msgid "water_unusual3"
msgstr ""
"החבר שלי מחכה לך בצפון. הוא אומר שהוא מאוד מתרגש לפגוש אותך. הוא צופה בך דרך הזרמים.\n"
" לא בצורה מפחידה. בערך."

msgid "water_gemuar_before1"
msgstr ""
"מפלצת מפחידה מופיעה. אפשר להרגיש את הכוח שלה. זה בטח הנגמון האגדי שגורם לכל הבעיות כאן.\n"
" אפילו המים נראים לחוצים."

msgid "water_gemuar_before2"
msgstr ""
"נראה שהיא רוצה לבחון את הכוח שלך. היא מתבוננת כמו מישהו שמנסה להחליט אם מה "
"שהוא רואה מרשים או מאכזב."

msgid "water_gemuar_before3"
msgstr ""
"הנגמון האגדי: יש לכם מספיק כוח לנצח אותי? תתכוננו לדו-קרב קשה, אם אתם מעזים.\n"
" מקווה שעשיתם מתיחות."

msgid "water_ending1"
msgstr ""
"ניצחת את הנגמון האגדי והחזרת את השלום לאזור.\n"
" המים נרגעים, הרוח שוככת, ומישהו במרחק נושם לרווחה."

msgid "water_ending2"
msgstr ""
"Gemuar התרשם מהכישרון שלך והצטרף לקבוצה שלך. נראה שהוא סקרן לגלות לאיזה בלגן"
" תיקלעו בפעם הבאה."

msgid "water_ending3"
msgstr ""
"הסיפור שלך באזור המים הגיע לסיומו. אפשר להמשיך לשחק אם רוצים, אבל זה סוף המשחק.\n"
" תושבי הכפרים בטח ידברו עליך עוד שנים, גם אם יתבלבלו בכמה פרטים."

msgid "water_ending4"
msgstr ""
"כל הכבוד ותודה ששיחקתם. נתראה במוד הנגמונים הבא. בפעם הבאה, תביאו חטיפים."

msgid "water_outskirts_dude"
msgstr "החוצפן"

msgid "xero_intro_1"
msgstr ""
"ברוכים הבאים לאזור פונדנט!\n"
"אזור פונדנט הוא מקום נפלא, מלא באנשים נפלאים מכל הסוגים!\n"
"בטוח שתאהבו את המקום!\n"
"את אזור פונדנט מנהל תאגיד אומניצ'אנל הנדיב.\n"
"הם דואגים שלכולם יהיה כל מה שצריך, ושכולם יהיו מוגנים מפני הנגמונים המפחידים!"

msgid "xero_intro_2"
msgstr ""
"את תאגיד אומניצ'אנל הגדול והנדיב מוביל איש אחד, מאז שנוסד לפני 25 שנה:\n"
"אייבל פליסק! יחד עם מועצת אומני וחיילי אומני.\n"
"הוא הביא יציבות ושגשוג לאזור פונדנט!"

msgid "xero_intro_3"
msgstr ""
"תודה שביקרתם באזור פונדנט!\n"
"אנחנו מקווים שתיהנו, בין אם באתם לכמה ימים ובין אם לכל החיים!"

msgid "xero_intro_question"
msgstr "מה השם שלך?"

msgid "xero_hideout1"
msgstr "לפניכם: מכון זירו לחקר וקידום נגמונים."

msgid "cherry_found"
msgstr "מצאת דובדבן."

msgid "youcantleave"
msgstr "הדלתות נעולות מבחוץ... אולי יש מפתח איפשהו?"

msgid "discovered_a_person"
msgstr "מצאת אותי! חה חה!"

msgid "a_serious_discussion"
msgstr ""
"כבר זמן מה שאני עוקבת מרחוק אחרי המסע שלך. אני שמחה שהעוזרים שלי הביאו אותך לכאן בלי שום נזק.\n"
"אוי, איפה הנימוסים שלי! \n"
"אני מיסה, ראשת מכון זירו לחקר וקידום נגמונים.\n"
"מה השם שלך, שוב? \n"
"....  .....  ....\n"
"${{name}}?\n"
"לא שם מרשים במיוחד לבעלים של נגמון בלי רישיון."

msgid "oops"
msgstr ""
"אה. כנראה שלא ידעת את זה...\n"
"אין סיבה לפחד. נגמון לצידך זה הדבר הכי טוב שיכול לקרות לך."

msgid "backstory"
msgstr ""
"לפני כשלושים שנה, קבוצה בשם אומניצ'אנל התחילה לשלוט בעיתונים ובטלוויזיה.\n"
"זמן קצר אחר כך, כמעט אי אפשר היה להגיד מה שחושבים.\n"
"אז אנשים התחילו להשתמש בנגמונים כדי להעביר הודעות וכדי ליישב ויכוחים. \n"
"לפני כעשר שנים התחילו להגביל את הנגמונים.\n"
"היום רק אנשים שקיבלו אישור יכולים לגדל נגמונים. \n"
"הקבוצה שלי משתמשת בנגמונים למחקר, ולכן לכולנו יש. \n"
"אצלך זה שונה. אין לך אישור מאומניצ'אנל. \n"
"אולי בדיוק לך חיכינו.\n"
"אומניצ'אנל קשוחים מאוד, אבל הם לא הסכנה היחידה כאן. \n"
"יש עוד ארגון, שנקרא ספיידר.\n"
"לא צריך לדאוג מהם יותר מדי, הם לא פעילים במיוחד באזור. \n"
"עכשיו נחזיר אותך לדרך. \n"
"אבל רק אם מסכימים לעזור לנו נגד אומניצ'אנל.\n"
"אחרת, אנחנו בעצמנו נספר לאומניצ'אנל הכול. \n"
"ואז הכול יילקח ממך. \n"
"אנחנו תמיד משגיחים."

msgid "backstory9"
msgstr "אז מה דעתך? לעזור לנו?"

msgid "sorryfurthis"
msgstr "בחירה טובה. סליחה, זה רק יעקצץ קצת."

msgid "mwah"
msgstr ""
"???: מה רצית? ... ... ... חבל מאוד. לפה לא נכנסים, גם אם הלבוש מתאים.\n"
"דרך אגב, אני אלי.\n"
"אלי: כן, זה אומניצ'אנל. אני רק שומרת פשוטה. ומי זה פה?\n"
"${{name}}...\n"
"הממ. שם חזק. הבית שלי לא רחוק... אולי אחרי העבודה נערוך דו-קרב קטן, ונראה כמה כוח יש לך?\n"
"... ... לא?! מה זאת אומרת לא? אלא אם... ... ג'ס כבר הספיקה להתיידד איתך! היא סובבה אותי כל הזמן הזה!"

msgid "mwah2"
msgstr "ג'ס!!!"

msgid "itslockedboi"
msgstr "אלי נעלה את הדלת מאחוריה..."

msgid "hellothere"
msgstr "???: שלום שלום!"

msgid "kmere"
msgstr "בואו לכאן, נדבר קצת!"

msgid "theinfo"
msgstr ""
"סליחה על הסצנה הזאת. לפעמים קשה להסתדר עם אלי, לא כמו עם הבת שלי, ג'ס.\n"
"אוי! איפה הנימוסים שלי. קוראים לי אה... יודעים מה? אני פשוט אכתוב את זה.\n"
"Aeble\n"
"מבטאים את זה \"אה-בלה\", אבל כולם פשוט קוראים לי אייבל. גם לך מותר, נראה לי...\n"
"אייבל: אני המנהל הראשי של אומניצ'אנל. כל שידור שרואים בטלוויזיה עובר את האישור שלי.\n"
"אבל אני לא היחיד שעושה את העבודה. לאומניצ'אנל יש הנהלה שעוזרת לנהל את המחוזות השונים.\n"
"ומה תגידו... אותה הנהלה נבחרת שוב ושוב, כל שנה!\n"
"המטרה של אומניצ'אנל היא לפתוח את העולם לכולם. אבל הדרך היחידה לעשות את זה, לעשות את כולם שווים,\n"
"הייתה להגביל את הנגמונים.\n"
"התחלנו בהחרמה, אבל רוב הנגמונים הצליחו לברוח. אז נאלצנו לנקוט צעדים קיצוניים.\n"
"ארגון האחות שלנו, ספיידר, פיתח חומר שיכול לשנות נגמונים.\n"
"הוא פעל על חלק מסתורי במוח שיש לכל נגמון, והעמיס עליו יותר מדי.\n"
"כשלמינת גייג' פלודל קיבלה יותר מדי חשמל, הרצון שלהם להתנגד נעלם, והם נעשו צייתנים.\n"
"בגלל תופעות לוואי עצובות שאף אחד לא ציפה להן, כמה זנים כמעט נעלמו לגמרי,\n"
"בעיקר Rockitten, Fruitera ו-Hydrone.\n"
"היום, חוץ מכמה נגמונים פראיים שנשארו, הדור הזה פוגש נגמונים רק כשהם עובדים בשבילנו.\n"
"נולדים יותר תינוקות מאי פעם, והאהדה לאומניצ'אנל לא ירדה מאז השנה שלפני ההגבלות.\n"
"נגמונים פראיים היו צרה גדולה בכל מקום, ואיימו על בני האדם. אומניצ'אנל תיקנו את זה והשליטו סדר.\n"
"בלי שליטה, נגמונים הם כוח הרסני, ומי שאומר אחרת משקר. סליחה, אני חייב ללכת לעבודה."

