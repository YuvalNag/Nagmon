msgid "pluson"
msgstr "Pluson"

msgid "pluson_description"
msgstr "A little plus with a spark in its tail. It loves adding things up."

msgid "cat_plus_spark"
msgstr "Plus Spark"

msgid "multivolt"
msgstr "Multivolt"

msgid "multivolt_description"
msgstr "Its lightning tail grew with every sum it solved."

msgid "cat_volt_plus"
msgstr "Volt Plus"

msgid "flaskling"
