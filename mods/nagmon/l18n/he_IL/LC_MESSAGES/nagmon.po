msgid "nudikill"
msgstr "נודי"

msgid "axolightl"
msgstr "אקסולייטל"

msgid "ampystoma"
msgstr "אמפיסטומה"

msgid "cardiling"
msgstr "קרדילינג"

msgid "cardiwing"
msgstr "קרדיווינג"

msgid "cardinale"
msgstr "שירונית"

msgid "cataspike"
