# Descriptions a child reads, with the Hebrew names and gentle words
# (docs/kids/SDD_ANDROID.md §2.7).

msgid "ampystoma_description"
msgstr "הצבעים הבוהקים של אמפיסטומה אומרים \"שימו לב!\". הוא מתחבא במים העכורים, ואוהב לצאת ליבשה בזמן סופות רעמים."

msgid "arthrobolt_description"
msgstr "לא נוח לו לתת הוראות לחבריו נאט ובולט, ולכן הוא לפעמים בורח. אבל אז לנאט ולבולט אין מי שיגיד להם מה לעשות."

msgid "bolt_description"
msgstr "כשבולט בסביבה, נאט מתהדק חזק יותר ומפיק יותר ניצוצות של אנרגיה."

msgid "nut_description"
msgstr "בספינות הגדולות שחוצות את האוקיינוסים, אלפי נאטים ובולטים נותנים כוח ומחזיקים את לוחות הפלדה יחד."

msgid "jemuar_description"
msgstr "האבנים היקרות על הגב שלו הן מהסוג שהיה במקום שבו נולד. לכן הרבה רוקיטנים גדלים מעל עורקי יהלומים."

msgid "kroki_description"
msgstr "קרוקי מבלה את רוב הזמן במים רדודים, ואוהב לנקוש בלסתות החזקות שלו."

msgid "krokivip_description"
msgstr "התנין הזה אוהב להתחבא בתוך המים ולהפתיע. ככל שהוא מתקרב להתפתחות, הוא מחפש מקווי מים גדולים יותר."

msgid "leviadile_description"
msgstr "לוויאדיל ענק ושוחה במעמקי הים. כל היצורים שם יודעים שהוא המלך של המים העמוקים."

msgid "puparmor_description"
msgstr "הגולם שלו קשה כמו אבן. אם פופרמור נופל על מישהו, נשארת לו בליטה בראש לכמה ימים."

msgid "tourbidi_description"
msgstr "מעגל של פטריות או תלתנים הוא מקום שבו טורבידים רוקדים."

msgid "cardiwing_description"
msgstr "השיר שלו מדהים, ובסוף כל שיר עפים ממנו ניצוצות חמים."

msgid "cardinale_description"
msgstr "הוא שומר על הקן שלו ועל השכנים הקטנים, ומרחיק כל מי שבא להציק להם."

msgid "rabbitosaur_description"
msgstr "המנהרות שלו ארוכות ורחבות, ושכנים ממחילות אחרות באים לבקר בהן."

msgid "nudikill_description"
msgstr "קוראים להם \"הכובענים\", כי הראש שלהם מזכיר כובע גבוה ומחודד."

msgid "dandicub_description"
msgstr "אחרי שהגורים נולדים, הם מרחפים לכל קצות העולם ומחפשים מקום חדש לגדול בו."

# --- solar-system animals (tools/art/import_solar_monsters.py) ---

msgid "lunibble"
msgstr "סהרית"

msgid "lunibble_description"
msgstr "ירח עגול וקטן. הירח לא מאיר בעצמו, הוא מחזיר את האור של השמש."

msgid "lunihare"
msgstr "ירחנב"

msgid "lunihare_description"
msgstr "הארנב הזה קופץ גבוה, כי על הירח כוח המשיכה חלש."

msgid "lunwarden"
msgstr "שומר ירח"

msgid "lunwarden_description"
msgstr "הוא שומר על המכתשים. כל מכתש נוצר כשסלע מהחלל נפל על הירח."

msgid "terrabub"
msgstr "ארצון"

msgid "terrabub_description"
msgstr "כדור כחול וירוק. כדור הארץ הוא המקום היחיד שאנחנו יודעים שיש בו חיים."

msgid "terratot"
msgstr "צב ארץ"

msgid "terratot_description"
msgstr "צב קטן שנושא עולם על הגב. רוב כדור הארץ מכוסה במים."

msgid "terravault"
msgstr "שומר ארץ"

msgid "terravault_description"
msgstr "שומר רגוע וחזק. האוויר של כדור הארץ מגן עלינו מהחלל."

msgid "heliobud"
msgstr "שמשון"

msgid "heliobud_description"
msgstr "כוכב קטן וזוהר. השמש היא כוכב, והאור שלה מגיע אלינו תוך כ-8 דקות."

msgid "heliolynx"
msgstr "להבון"

msgid "heliolynx_description"
msgstr "חתול להבות חם ושמח. השמש חמה מאוד, ולכן לא מסתכלים עליה ישר."

msgid "heliarch"
msgstr "כתר שמש"

msgid "heliarch_description"
msgstr "הכתר שלו זוהר כמו הכתר של השמש, שרואים רק בזמן ליקוי חמה."

msgid "solwind"
msgstr "רוחית"

msgid "solwind_description"
msgstr "משב קטן וירוק. רוח השמש היא זרם של חלקיקים שיוצא מהשמש."

msgid "aurorail"
msgstr "זוהר רוח"

msgid "aurorail_description"
msgstr "זנב של זוהר. זוהר קוטבי נוצר כשרוח השמש פוגעת באוויר שלנו."

msgid "sailbit"
msgstr "מפרשון"

msgid "sailbit_description"
msgstr "מפרש קטן של אור. אור השמש יכול לדחוף חללית."

msgid "sailray"
msgstr "כנף שמש"

msgid "sailray_description"
msgstr "מפרש רחב וקל. מפרש שמש לא צריך דלק."

msgid "mercurip"
msgstr "כספיפון"

msgid "mercurip_description"
msgstr "סלע קטן עם מכתשים. חמה הוא כוכב הלכת הקרוב ביותר לשמש."

msgid "mercurush"
msgstr "זריז חמה"

msgid "mercurush_description"
msgstr "לטאה זריזה. שנה בחמה נמשכת רק 88 ימים, ולכן הכול שם רץ מהר."

msgid "mercuram"
msgstr "סלע חמה"

msgid "mercuram_description"
msgstr "איל סלעי וחזק. בחמה חם מאוד ביום וקר מאוד בלילה."

msgid "venubud"
msgstr "ענן נוגה"

msgid "venubud_description"
msgstr "ענן צהוב ורך. נוגה עטופה בעננים עבים."

msgid "venumoth"
msgstr "פרפר נוגה"

msgid "venumoth_description"
msgstr "פרפר עננים. בנוגה חם מאוד, כי העננים שלה שומרים על החום."

msgid "venuveil"
msgstr "צעיף נוגה"

msgid "venuveil_description"
msgstr "הכנפיים שלו כמו צעיף של עננים. נוגה מסתובבת לאט, ובכיוון הפוך."

msgid "rustip"
msgstr "אדומון"

msgid "rustip_description"
msgstr "כדור אדום של חלודה. מאדים אדום, כי יש בו הרבה ברזל חלוד."

msgid "marskip"
msgstr "קפץ מאדים"

msgid "marskip_description"
msgstr "לטאה קופצנית. במאדים יש הר געש ענק, הר אולימפוס."

msgid "marstrix"
msgstr "אביר מאדים"

msgid "marstrix_description"
msgstr "אביר אדום ואמיץ. רובוטים כבר חוקרים את פני מאדים."

msgid "roveroo"
msgstr "רוברון"

msgid "roveroo_description"
msgstr "רובר קטן על גלגלים. רוברים נוסעים על כוכבי לכת ומצלמים."

msgid "roverex"
msgstr "סייר מאדים"

msgid "roverex_description"
msgstr "רובר של מאדים. רוברים חוקרים סלעים ואדמה בלי אדם בפנים."

msgid "asterchip"
msgstr "סלעון"

msgid "asterchip_description"
msgstr "סלע קטן וסקרן. חגורת האסטרואידים נמצאת בין מאדים לצדק."

msgid "astercrab"
msgstr "ארמדיל סלע"

msgid "astercrab_description"
msgstr "ארמדיל עם שריון של סלע. אסטרואידים הם שאריות מהזמן שנוצרו כוכבי הלכת."

msgid "asterfort"
msgstr "מצודת סלע"

msgid "asterfort_description"
msgstr "מצודה על ארבע רגליים. רוב האסטרואידים קטנים מאוד לעומת כוכב לכת."

msgid "meteet"
msgstr "מטאורון"

msgid "meteet_description"
msgstr "סלע קטן ולוהט. מטאור הוא פס אור שנוצר כשסלע נכנס לאוויר."

msgid "meteoroar"
msgstr "שובלון"

msgid "meteoroar_description"
msgstr "שועל עם זנב לוהט. מה שקוראים לו כוכב נופל הוא מטאור, לא כוכב."

msgid "meteohelm"
msgstr "איל מטאור"

msgid "meteohelm_description"
msgstr "איל עם קרניים בוערות. מטאור שנוחת על הקרקע נקרא מטאוריט."

msgid "dustip"
msgstr "אבקון"

msgid "dustip_description"
msgstr "גרגר אבק קטן. אבק בחלל מפזר את אור השמש."

msgid "zodiacat"
msgstr "אבקרן"

msgid "zodiacat_description"
msgstr "חתול של אור עדין. אור גלגל המזלות הוא זוהר חלש של אבק בחלל."

msgid "jovibud"
msgstr "פס צדק"

msgid "jovibud_description"
msgstr "כדור עם פסים. צדק הוא כוכב הלכת הגדול ביותר."

msgid "jovihog"
msgstr "ענן צדק"

msgid "jovihog_description"
msgstr "חזרזיר עננים. בצדק יש סערה ענקית, הכתם האדום, כבר מאות שנים."

msgid "jovigale"
msgstr "סוער צדק"

msgid "jovigale_description"
msgstr "סוער ואמיץ. צדק עשוי בעיקר מגז, ואין בו קרקע לעמוד עליה."

msgid "iobud"
msgstr "איופון"

msgid "iobud_description"
msgstr "כדור צהוב ומנומר. איו הוא ירח של צדק, ויש בו הרבה הרי געש."

msgid "iolisk"
msgstr "לטא איו"

msgid "iolisk_description"
msgstr "לטאה מנומרת. ההרים הגעשיים של איו פולטים גז וסלע חם."

msgid "iopyre"
msgstr "געש איו"

msgid "iopyre_description"
msgstr "לטאה לוהטת. איו הוא המקום הכי געשי במערכת השמש."

msgid "europip"
msgstr "אירופית"

msgid "europip_description"
msgstr "דג קטן וקריר. מתחת לקרח של אירופה אולי יש אוקיינוס."

msgid "europod"
msgstr "צב הקרח"

msgid "europod_description"
msgstr "צב של קרח. אירופה היא ירח של צדק."

msgid "europan"
msgstr "שומר העומק"

msgid "europan_description"
msgstr "שומר של המעמקים. האוקיינוס שמתחת לקרח של אירופה עמוק מאוד."

msgid "ganybit"
msgstr "גניפון"

msgid "ganybit_description"
msgstr "כדור אפרפר וגדול. גנימד הוא הירח הגדול ביותר במערכת השמש."

msgid "ganyhorn"
msgstr "ביזוגנימד"

msgid "ganyhorn_description"
msgstr "ביזון עם קרני קרח. גנימד גדול יותר מכוכב חמה."

msgid "ganyguard"
msgstr "מגן גנימד"

msgid "ganyguard_description"
msgstr "שומר עם מגן. לגנימד יש שדה מגנטי משלו."

msgid "ringlet"
msgstr "טבעון"

msgid "ringlet_description"
msgstr "כדור קטן עם טבעת. שבתאי מוקף בטבעות."

msgid "saturnip"
msgstr "חיפושבתאי"

msgid "saturnip_description"
msgstr "חיפושית עם טבעות. הטבעות של שבתאי עשויות מגושי קרח וסלע."

msgid "ringwarden"
msgstr "שומר טבעות"

msgid "ringwarden_description"
msgstr "הוא שומר על הטבעות הנוצצות. לשבתאי יש יותר ממאה ירחים."

msgid "titanip"
msgstr "טיטיפון"

msgid "titanip_description"
msgstr "כדור כתום ומעורפל. טיטאן הוא ירח של שבתאי, ויש לו אוויר עבה."

msgid "titanewt"
msgstr "טריטיטאן"

msgid "titanewt_description"
msgstr "טריטון קטן. בטיטאן יש אגמים של מתאן נוזלי."

msgid "titanveil"
msgstr "צעיף טיטאן"

msgid "titanveil_description"
msgstr "עטוף בערפל כתום. בטיטאן יש הרים ואגמים מתחת לערפל."

msgid "gravip"
msgstr "כבידון"

msgid "gravip_description"
msgstr "כדור קטן שמקיף. כבידה היא משיכה בין דברים."

msgid "orbitail"
msgstr "זנב מסלול"

msgid "orbitail_description"
msgstr "הוא מקיף בלי הפסקה. כוכבי הלכת מקיפים את השמש בגלל הכבידה שלה."

msgid "gravivault"
msgstr "שומר מסלול"

msgid "gravivault_description"
msgstr "שומר המסלולים. הכבידה מחזיקה את הירח במסלול סביב כדור הארץ."

msgid "tiltip"
msgstr "נטיפון"

msgid "tiltip_description"
msgstr "כדור כחול ונוטה. אורנוס מסתובב כמעט על הצד."

msgid "uranurtle"
msgstr "כלבנטוי"

msgid "uranurtle_description"
msgstr "שוחה סביב טבעת, נוטה על הצד. אורנוס הוא ענק קרח."

msgid "tiltitan"
msgstr "נטייתן"

msgid "tiltitan_description"
msgstr "ענק קרח רגוע. אורנוס הוא אחד מכוכבי הלכת הקרים ביותר."

msgid "nepbit"
msgstr "נפטיפון"

msgid "nepbit_description"
msgstr "טיפה כחולה. נפטון רחוק מאוד מהשמש, והאור שם חלש."

msgid "nepdart"
msgstr "גל נפטון"

msgid "nepdart_description"
msgstr "דג גלים מהיר. בנפטון נושבות הרוחות החזקות ביותר במערכת השמש."

msgid "nepstorm"
msgstr "סער נפטון"

msgid "nepstorm_description"
msgstr "מנטה של סערה. שנה בנפטון נמשכת כ-165 שנים של כדור הארץ."

msgid "plutot"
msgstr "פלוטיפון"

msgid "plutot_description"
msgstr "כדור קטן וחמוד. פלוטו הוא כוכב לכת ננסי."

msgid "plutopaw"
msgstr "חתול פלוטו"

msgid "plutopaw_description"
msgstr "חתול על הקרח. בפלוטו יש אזור גדול בצורת לב."

msgid "plutaur"
msgstr "נמר פלוטו"

msgid "plutaur_description"
msgstr "נמר של הקור. פלוטו רחוק מאוד, וקר מאוד."

msgid "kuipip"
msgstr "קרחיפון"

msgid "kuipip_description"
msgstr "כדור קרח קטן. חגורת קויפר נמצאת רחוק, אחרי נפטון."

msgid "kuipine"
msgstr "קיפוקרח"

msgid "kuipine_description"
msgstr "קיפוד קרח. בחגורת קויפר יש הרבה גופים קפואים."

msgid "kuipcrest"
msgstr "דורבקרח"

msgid "kuipcrest_description"
msgstr "דורבנים מגבישי קרח. חלק מהשביטים מגיעים משם."

msgid "combit"
msgstr "שביטון"

msgid "combit_description"
msgstr "ענן קטן של קרח עם זנב. שביט הוא גוש של קרח ואבק."

msgid "cometail"
msgstr "זנב שביט"

msgid "cometail_description"
msgstr "דרקון קטן עם זנב. ליד השמש הקרח של השביט נמס והזנב נוצר."

msgid "cometrail"
msgstr "שרביט שביט"

msgid "cometrail_description"
msgstr "שובל זוהר ארוך. הזנב של שביט תמיד מצביע הרחק מהשמש."

msgid "probip"
msgstr "גשושון"

msgid "probip_description"
msgstr "גשושית קטנה, חללית בלי אנשים, עם מצלמה ומכשירים."

msgid "probewing"
msgstr "סייר כנף"

msgid "probewing_description"
msgstr "גשושית עם כנפי שמש. שולחים גשושיות לכוכבי לכת רחוקים."

msgid "nagmon_solar_astronomer"
msgstr "האסטרונומית"

msgid "nagmon_solar_mila"
msgstr "מילה"

msgid "nagmon_solar_owl"
msgstr "הינשוף"

msgid "nagmon_solar_moon_engineer"
msgstr "מהנדסת הירח"

msgid "nagmon_solar_rover_driver"
msgstr "נהג הרובר"

msgid "nagmon_solar_sage"
msgstr "החכם"

msgid "nagmon_solar_grey_hood"
msgstr "הברדס האפור"

msgid "nagmon_solar_quiz_good"
msgstr "נכון! הנה 3 מטבעות בשבילכם."

msgid "nagmon_solar_quiz_free"
msgstr "נכון! כל הכבוד. המטבעות להיום נגמרו, אבל תמיד כיף ללמוד."

msgid "nagmon_solar_quiz_wrong"
msgstr "לא נורא! עכשיו ראינו את התשובה. בפעם הבאה יהיה קל יותר."

msgid "nagmon_solar_quiz_mission_wrong"
msgstr "לא נורא! עכשיו ראינו את התשובה. אפשר לחזור ולנסות שוב מתי שרוצים."

msgid "nagmon_solar_moon_moon_engineer"
msgstr "אני מהנדסת הירח. על הירח אין אוויר, ולכן אין שם רוח ואין קולות. הירח מלא מכתשים, שנוצרו כשסלעים מהחלל פגעו בו."

msgid "nagmon_solar_moon_moon_engineer_ask"
msgstr "אני רושמת את המכתשים ביומן, ויש המון. תעזרו לי עם שאלה אחת?"

msgid "nagmon_solar_moon_moon_engineer_good"
msgstr "נכון! המכתשים נרשמו ביומן. קבלו 10 מטבעות על העזרה."

msgid "nagmon_solar_moon_owl"
msgstr "הירח לא מאיר בעצמו. אנחנו רואים אור שמש שחוזר ממנו. הירח מקיף את כדור הארץ בערך פעם בחודש."

msgid "nagmon_solar_sun_owl"
msgstr "השמש היא כוכב: כדור ענק של גז לוהט. לעולם לא מסתכלים על השמש ישר. מסתכלים עליה רק דרך מסנן מיוחד, ועם מבוגר."

msgid "nagmon_solar_sun_owl_ask"
msgstr "המסנן המגן שלי אבד בערפל! בלעדיו אי אפשר להסתכל על השמש בבטחה. אולי האישה עם הברדס האפור מצאה אותו?"

msgid "nagmon_solar_sun_owl_wait"
msgstr "עוד לא מצאנו את המסנן שלי. נסו לשאול את האישה עם הברדס האפור."

msgid "nagmon_solar_sun_owl_found"
msgstr "זה המסנן שלי! תודה. מסנן כזה מגן על העיניים, ובלעדיו לא מסתכלים על השמש. יש לי עוד שאלה בשבילכם."

msgid "nagmon_solar_sun_owl_good"
msgstr "נכון! קבלו 12 מטבעות, ותודה שמצאתם את המסנן."

msgid "nagmon_solar_sun_grey_hood"
msgstr "השמש גדולה כל כך שיותר ממיליון כדורי ארץ היו נכנסים בתוכה. האור שלה לוקח בערך שמונה דקות להגיע אלינו."

msgid "nagmon_solar_sun_grey_hood_filter"
msgstr "מצאתי בערפל מסנן מוזר. אולי הוא של הינשוף? בבקשה, קחו אותו אליו."

msgid "nagmon_solar_rocky_planets_rover_driver"
msgstr "אני נוהג ברובר על מאדים. האדמה שם אדומה, כי יש בה ברזל חלוד. על מאדים יש הר געש ענק בשם אולימפוס."

msgid "nagmon_solar_rocky_planets_rover_driver_ask"
msgstr "רוצים לנסוע איתי? יהיו שלוש תחנות בדרך, ובכל תחנה שאלה."

msgid "nagmon_solar_rocky_planets_rover_driver_good"
msgstr "הגענו! נסיעה יפה. קבלו 15 מטבעות."

msgid "nagmon_solar_rocky_planets_rover_driver_weak"
msgstr "הדרך הייתה קצת משובשת, אבל למדנו בדרך. אפשר לנסוע שוב מתי שרוצים."

msgid "nagmon_solar_rocky_planets_sage"
msgstr "ארבעת כוכבי הלכת הראשונים סלעיים: חמה, נוגה, כדור הארץ ומאדים. יש להם קרקע קשה. כדור הארץ הוא המקום היחיד שאנחנו יודעים שיש בו חיים."

msgid "nagmon_solar_rocky_planets_owl"
msgstr "חמה הכי קרובה לשמש, אבל נוגה הכי חמה, בגלל העננים העבים שלה. יום אחד על נוגה ארוך יותר משנה שלה."

msgid "nagmon_solar_giants_sage"
msgstr "צדק הוא כוכב הלכת הגדול ביותר. לשבתאי יש טבעות של קרח וסלעים. שניהם עשויים בעיקר מגז."

msgid "nagmon_solar_giants_sage_ask"
msgstr "חידה בשבילכם: יש לי טבעות יפות של קרח וסלעים, ואני הכוכב השישי מהשמש. מי אני? נגלה את התשובה אחרי שאלה אחת."

msgid "nagmon_solar_giants_sage_good"
msgstr "נכון! והתשובה לחידה: שבתאי, הכוכב עם הטבעות. הנה 18 מטבעות."

msgid "nagmon_solar_giants_sage_wrong"
msgstr "לא נורא! עכשיו ראינו את התשובה. והתשובה לחידה: שבתאי, הכוכב עם הטבעות. אפשר לנסות שוב."

msgid "nagmon_solar_giants_moon_engineer"
msgstr "לצדק יש עשרות ירחים. גנימד, הגדול שבהם, גדול אפילו מכוכב חמה. אירופה, ירח אחר של צדק, מכוסה בקרח."

msgid "nagmon_solar_giants_owl"
msgstr "בצדק אין קרקע לעמוד עליה: הוא עשוי בעיקר מגז. יש בו סערה אדומה ענקית, שנראית כבר יותר ממאה שנה."

msgid "nagmon_solar_outer_grey_hood"
msgstr "כאן רחוק וקר. אורנוס ונפטון הם ענקי קרח. האור מהשמש מגיע לנפטון אחרי בערך ארבע שעות."

msgid "nagmon_solar_outer_grey_hood_ask"
msgstr "יש לי שלושה קלפים מהקצה של המערכת. תסתכלו עליהם, ואחר כך שאלה אחת."

msgid "nagmon_solar_outer_grey_hood_card1"
msgstr "קלף ראשון, נפטון: כוכב הלכת הרחוק ביותר מהשמש, עם רוחות חזקות מאוד."

msgid "nagmon_solar_outer_grey_hood_card2"
msgstr "קלף שני, פלוטו: כוכב לכת ננסי, קטן מהירח שלנו, ועל פניו אזור בצורת לב."

msgid "nagmon_solar_outer_grey_hood_card3"
msgstr "קלף שלישי, שביט: כדור של קרח ואבק. כשהוא מתקרב לשמש, הוא מפתח זנב."

msgid "nagmon_solar_outer_grey_hood_good"
msgstr "נכון! הקלפים שלכם. קבלו 25 מטבעות."

msgid "nagmon_solar_outer_rover_driver"
msgstr "גשושיות טסות לכאן במשך שנים. אין להן נהג, רק אנטנה שמדברת איתנו. לפעמים האות לוקח שעות להגיע."

msgid "nagmon_solar_outer_owl"
msgstr "פלוטו הוא כוכב לכת ננסי. שביטים באים מהאזור הקפוא בקצה המערכת. מכאן השמש נראית כמו כוכב קטן."

msgid "nagmon_solar_station_astronomer"
msgstr "ברוכים הבאים לתחנת החלל! דרך הטלסקופ רואים כוכבים רחוקים. האור של חלק מהם נסע אלינו שנים רבות."

msgid "nagmon_solar_station_astronomer_how"
msgstr "יש חמישה מקומות: הירח, ליד השמש, כוכבי הלכת הסלעיים, הענקים והקצה. כל מקום נפתח כשהחבר החזק שלכם מגיע לרמה מסוימת, והנסיעה עולה מטבעות. מקום נחשב גמור כשמסיימים בו את המשימה, או כשתופסים בו שלושה יצורים. כשכל החמישה גמורים, מחכה בתפריט הנסיעות מבחן האסטרונומית. מי שמצליח בו מקבל את התג."

msgid "nagmon_solar_station_astronomer_ready"
msgstr "כל המקומות גמורים! אפשר לפתוח את תפריט הנסיעות ולגשת למבחן האסטרונומית."

msgid "nagmon_solar_station_mila"
