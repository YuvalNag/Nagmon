# Descriptions a child reads, with the Hebrew names and gentle words
# (docs/kids/SDD_ANDROID.md §2.7).

msgid "ampystoma_description"
msgstr "הצבעים הבוהקים של אמפיסטומה אומרים \"שימו לב!\". הוא מתחבא במים העכורים, ואוהב לצאת ליבשה בזמן סופות רעמים."

msgid "arthrobolt_description"
msgstr "לא נוח לו לתת הוראות לחבריו נאט ובולט, ולכן הוא לפעמים בורח. אבל אז לנאט ולבולט אין מי שיגיד להם מה לעשות."

msgid "bolt_description"
msgstr "כשבולט בסביבה, נאט מתהדק חזק יותר ומפיק יותר ניצוצות של אנרגיה."

msgid "nut_description"
msgstr "בספינות הגדולות שחוצות את האוקיינוסים, אלפי נאטים ובולטים נותנים כוח ומחזיקים את לוחות הפלדה יחד."

msgid "jemuar_description"
msgstr "האבנים היקרות על הגב שלו הן מהסוג שהיה במקום שבו נולד. לכן הרבה רוקיטנים גדלים מעל עורקי יהלומים."

msgid "kroki_description"
msgstr "קרוקי מבלה את רוב הזמן במים רדודים, ואוהב לנקוש בלסתות החזקות שלו."

msgid "krokivip_description"
msgstr "התנין הזה אוהב להתחבא בתוך המים ולהפתיע. ככל שהוא מתקרב להתפתחות, הוא מחפש מקווי מים גדולים יותר."

msgid "leviadile_description"
msgstr "לוויאדיל ענק ושוחה במעמקי הים. כל היצורים שם יודעים שהוא המלך של המים העמוקים."

msgid "puparmor_description"
msgstr "הגולם שלו קשה כמו אבן. אם פופרמור נופל על מישהו, נשארת לו בליטה בראש לכמה ימים."

msgid "tourbidi_description"
msgstr "מעגל של פטריות או תלתנים הוא מקום שבו טורבידים רוקדים."

msgid "cardiwing_description"
msgstr "השיר שלו מדהים, ובסוף כל שיר עפים ממנו ניצוצות חמים."

msgid "cardinale_description"
msgstr "הוא שומר על הקן שלו ועל השכנים הקטנים, ומרחיק כל מי שבא להציק להם."

msgid "rabbitosaur_description"
msgstr "המנהרות שלו ארוכות ורחבות, ושכנים ממחילות אחרות באים לבקר בהן."

msgid "nudikill_description"
msgstr "קוראים להם \"הכובענים\", כי הראש שלהם מזכיר כובע גבוה ומחודד."

msgid "dandicub_description"
msgstr "אחרי שהגורים נולדים, הם מרחפים לכל קצות העולם ומחפשים מקום חדש לגדול בו."
